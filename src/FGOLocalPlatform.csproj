<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FGOLocalPlatform</AssemblyName>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- The one place the version is written. The About page and the updater both read it back
         from the assembly, and package.ps1 names the release zip after it. -->
    <Version>1.3.0</Version>
    <!-- Ahead-of-time compiled so the first window appears without waiting for the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <Product>FGOAC scooby</Product>
    <AssemblyTitle>FGOAC scooby</AssemblyTitle>
    <Company>FGOAC scooby</Company>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>Latest</LangVersion>
    <Nullable>annotations</Nullable>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>platform.ico</ApplicationIcon>
    <ApplicationManifest Condition="'$(ShellDev)' != 'true'">app.manifest</ApplicationManifest>
    <!-- ShellDev=true: no elevation, so the window can be opened and captured by a normal process. -->
    <ApplicationManifest Condition="'$(ShellDev)' == 'true'">app.dev.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DeckReaderUI\**\*.cs" />
    <Compile Include="DeckReaderUI.Kancolle\**\*.cs" />
    <Compile Include="FGOLocalPlatform\**\*.cs" />
    <Compile Include="FGOLocalPlatform.PhotoAssets\**\*.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="app.xaml" />
    <Page Include="FGOLocalPlatform\Settings\audiosettingsview.xaml" />
    <Page Include="FGOLocalPlatform\Events\bannersettingsview.xaml" />
    <Page Include="FGOLocalPlatform\Events\eventspage.xaml" />
    <Page Include="FGOLocalPlatform\Events\eventswitchesview.xaml" />
    <Page Include="FGOLocalPlatform\Account\accountspage.xaml" />
    <Page Include="FGOLocalPlatform\BattleDebug\battledebugpage.xaml" />
    <Page Include="FGOLocalPlatform\Mods\modspage.xaml" />
    <Page Include="FGOLocalPlatform\Mods\modinstallview.xaml" />
    <Page Include="FGOLocalPlatform\Mods\modloopeditor.xaml" />
    <Page Include="FGOLocalPlatform\Mods\modmasterview.xaml" />
    <Page Include="FGOLocalPlatform\Mods\modportraitpicker.xaml" />
    <Page Include="FGOLocalPlatform\Mods\modsettingsview.xaml" />
    <Page Include="FGOLocalPlatform\PhotoMode\photomodepage.xaml" />
    <Page Include="FGOLocalPlatform\Settings\battleeffectsview.xaml" />
    <Page Include="FGOLocalPlatform\Settings\bindingssettingsview.xaml" />
    <Page Include="FGOLocalPlatform\Account\communityaccountdialog.xaml" />
    <Page Include="FGOLocalPlatform\Online\communityserverview.xaml" />
    <Page Include="FGOLocalPlatform\Cards\cardquantitywindow.xaml" />
    <Page Include="FGOLocalPlatform\Cards\cardvariantswindow.xaml" />
    <Page Include="FGOLocalPlatform\Settings\controlsettingsview.xaml" />
    <Page Include="FGOLocalPlatform\Settings\cursorsettingsview.xaml" />
    <Page Include="FGOLocalPlatform\BattleDebug\debugsettingsview.xaml" />
    <Page Include="FGOLocalPlatform\Settings\pcplaysettingsview.xaml" />
    <Page Include="FGOLocalPlatform\Settings\diagnosticsview.xaml" />
    <Page Include="mainwindow.xaml" />
    <Page Include="FGOLocalPlatform\Cards\nameprompt.xaml" />
    <Page Include="FGOLocalPlatform\Account\newaccountdialog.xaml" />
    <Page Include="photocontrols.xaml" />
    <Page Include="FGOLocalPlatform\Account\recoveraccountdialog.xaml" />
    <Page Include="FGOLocalPlatform\Account\recoverykeydialog.xaml" />
    <Page Include="FGOLocalPlatform\Settings\serversettingsview.xaml" />
    <Page Include="FGOLocalPlatform\Cards\summonsettingswindow.xaml" />
    <Page Include="FGOLocalPlatform\Startup\whatsnewdialog.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="platform.ico" />
    <!-- Static faces: WPF does not load the variable Geist files. -->
    <Resource Include="Fonts\Geist-Regular.ttf" />
    <Resource Include="Fonts\Geist-Medium.ttf" />
    <Resource Include="Fonts\Geist-SemiBold.ttf" />
    <Resource Include="Fonts\Geist-Bold.ttf" />
    <Resource Include="Fonts\GeistMono-Regular.ttf" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="FGOLocalPlatform.CardNames.json" LogicalName="FGOLocalPlatform.CardNames.json" />
    <EmbeddedResource Include="FGOLocalPlatform.CraftEffects.json" LogicalName="FGOLocalPlatform.CraftEffects.json" />
    <EmbeddedResource Include="FGOLocalPlatform.EventTogglePatch.json" LogicalName="FGOLocalPlatform.EventTogglePatch.json" />
    <EmbeddedResource Include="FGOLocalPlatform.EventNames.json" LogicalName="FGOLocalPlatform.EventNames.json" />
    <EmbeddedResource Include="FGOLocalPlatform.NativeBgmLoudness.json" LogicalName="FGOLocalPlatform.NativeBgmLoudness.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The author's build references a copy of this assembly beside the game. The package is
         the same library at the same assembly identity (0.8.8.0), restored from nuget.org, so
         the project builds on a machine that has no game install. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <!-- BC7 encoding of the MOD sprites, the library Cloud23333's launcher uses. -->
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>
</Project>
