<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FGOLocalPlatform.CommunityAccountDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="บัญชีใหม่" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource GroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" Closing="Window_OnClosing">
  <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20" Margin="10">
    <StackPanel>
      <TextBlock Name="LabelText" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource TextSoftBrush}" Margin="0,0,0,14" />
      <TextBlock Text="ชื่อมาสเตอร์" FontSize="14" Foreground="{StaticResource TextBrush}" />
      <TextBox Name="NameTextBox" MaxLength="16" Margin="0,6,0,6" AutomationProperties.Name="Master name" />
      <TextBlock Name="NameProblemText" Visibility="Collapsed" Style="{StaticResource HelpTextStyle}" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,6" />
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" Text="ผู้เล่นคนอื่นจะเห็นชื่อนี้ และเปลี่ยนภายหลังไม่ได้ ใช้ได้สูงสุด 16 ตัวอักษร A ถึง Z ตัวเลข ช่องว่าง _ หรือ -" />
      <CheckBox Name="MachineIdCheckBox" Content="ส่งรหัสเครื่อง (machine id) ของพีซีนี้" IsChecked="True" Margin="0,0,0,6" />
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" Text="machine id คือค่าแฮชทางเดียวของ Windows machine GUID และหมายเลขซีเรียลของไดรฟ์ระบบในเครื่องนี้ ไม่สามารถย้อนกลับไปอ่านค่าทั้งสองได้ และจะไม่มีการส่งข้อมูลอื่นของเครื่องนี้ เซิร์ฟเวอร์จะเก็บค่านี้ไว้กับบัญชี เพื่อให้ผู้ดูแลแบนได้ทั้งเครื่อง ไม่ใช่แค่บัญชี เมื่อฝ่าฝืนกฎของเซิร์ฟเวอร์ ยกเลิกเครื่องหมายถูกเพื่อไม่ส่ง machine id" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Name="CreateButton" Content="สร้าง" Style="{StaticResource AccentButtonStyle}" Width="96" IsDefault="True" Click="CreateButton_OnClick" />
        <Button Name="CancelButton" Content="ยกเลิก" Width="96" IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
