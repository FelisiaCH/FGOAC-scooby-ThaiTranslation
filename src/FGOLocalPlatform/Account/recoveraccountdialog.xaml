<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FGOLocalPlatform.RecoverAccountDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Recover Account" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource GroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
  <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20" Margin="10">
    <StackPanel>
      <TextBlock Name="LabelText" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource TextSoftBrush}" />
      <TextBox Name="KeyTextBox" MaxLength="128" FontFamily="{StaticResource DigitFont}" Margin="0,6,0,6" />
      <TextBlock Name="KeyProblemText" Visibility="Collapsed" Style="{StaticResource HelpTextStyle}" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,6" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Content="Recover" Style="{StaticResource AccentButtonStyle}" Width="96" IsDefault="True" Click="RecoverButton_OnClick" />
        <Button Content="Cancel" Width="96" IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
