<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FGOLocalPlatform.RecoveryKeyDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Recovery Key" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Closing="Dialog_OnClosing" Background="{StaticResource GroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
  <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20" Margin="10">
    <StackPanel>
      <TextBlock Name="HeadingText" FontSize="16" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
      <TextBlock Text="Recovery key" FontSize="14" Foreground="{StaticResource TextSoftBrush}" />
      <TextBox Name="KeyTextBox" IsReadOnly="True" FontFamily="{StaticResource DigitFont}" FontSize="16" TextAlignment="Center" Margin="0,6,0,12" />
      <TextBlock Name="NoticeText" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,16" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Copy" Width="96" Click="CopyButton_OnClick" />
        <Button Content="Save to File" Width="120" Click="SaveButton_OnClick" />
        <Button Content="Done" Style="{StaticResource AccentButtonStyle}" Width="96" Click="DoneButton_OnClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
