<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.EventSwitchesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="View_OnLoaded">
  <UserControl.Resources>
    <!-- A group heading: its title on the page surface, a lighter surface under the pointer. -->
    <Style x:Key="HeadingToggleStyle" TargetType="{x:Type ToggleButton}">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource IceFocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border Name="Surface" Background="Transparent" CornerRadius="6" Padding="10,8">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{StaticResource PlateBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel Margin="28,16,28,28" MaxWidth="900" HorizontalAlignment="Left">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" Text="อีเวนต์ที่ติ๊กไว้จะเปิดอยู่ใน Terminal ส่วนอีเวนต์ที่ปิดสวิตช์จะปิดทางเข้า ภารกิจ ไอเทมดรอป และโบนัสบนเซิร์ฟเวอร์ ไอเทมและความคืบหน้าที่ได้รับไปแล้วจะยังอยู่ และการต่อสู้ที่เริ่มไปแล้วจะจบตามที่เริ่มไว้ การเปลี่ยนแปลงทุกครั้งจะถูกบันทึกทันที" />
      <WrapPanel Margin="0,0,0,8">
        <Button Content="เปิดทั้งหมด" Margin="0,0,8,8" Click="AllOn_OnClick" />
        <Button Content="ปิดทั้งหมด" Margin="0,0,8,8" Click="AllOff_OnClick" />
        <Button Name="ReleaseOrderButton" Content="ลำดับตามวันเปิด" Margin="0,0,24,8" ToolTip="จัดทุกประเภทกลับเป็นลำดับตามที่อีเวนต์เปิดครั้งแรก" Click="ReleaseOrder_OnClick" />
        <Button Content="บนสุด" Tag="top" Margin="0,0,8,8" ToolTip="ย้ายอีเวนต์ที่เลือกไปบนสุดของประเภทเดียวกัน" Click="Move_OnClick" />
        <Button Content="ขึ้น" Tag="up" Margin="0,0,8,8" Click="Move_OnClick" />
        <Button Content="ลง" Tag="down" Margin="0,0,8,8" Click="Move_OnClick" />
        <Button Content="ล่างสุด" Tag="bottom" Margin="0,0,8,8" ToolTip="ย้ายอีเวนต์ที่เลือกไปล่างสุดของประเภทเดียวกัน" Click="Move_OnClick" />
      </WrapPanel>
      <TextBlock Name="StatusText" Style="{StaticResource HelpTextStyle}" Margin="0,0,0,12" />
    </StackPanel>
    <ListBox Name="EventList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="อีเวนต์" />
  </DockPanel>
</UserControl>
