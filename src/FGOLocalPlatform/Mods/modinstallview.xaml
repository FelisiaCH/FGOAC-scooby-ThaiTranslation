<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.ModInstallView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,12,0,0" MaxWidth="760" HorizontalAlignment="Left">
      <WrapPanel>
        <Button Name="ImportButton" Content="นำเข้าแพ็กเกจ" VerticalAlignment="Center" Margin="0,0,12,0" Click="Install" />
        <TextBlock Name="ImportNotice" Style="{StaticResource HelpTextStyle}" VerticalAlignment="Center" Text="Package import has a known problem, and Cloud23333 advises against using it." />
      </WrapPanel>
      <CheckBox Name="LoadOnInstall" Content="ใช้ทันทีหลังนำเข้า" IsChecked="True" HorizontalAlignment="Left" Margin="0,12,0,0" />
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,12,0,0" Text="แพ็กเกจจะถูกเก็บแยกจากการแก้ไขของคุณเองและไม่เขียนทับของคุณ ขณะที่ใช้แพ็กเกจสำหรับเพลง บทสนทนา หรือภาพ Master แพ็กเกจจะทำงานแทนของคุณเอง หากต้องการกลับไปใช้ของคุณ ให้เอาเครื่องหมายติ๊กออกจาก “ใช้แพ็กเกจนี้แทนของฉัน” การเปลี่ยนแปลงจะมีผลเมื่อเริ่มเกมครั้งถัดไป" />
      <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,16,0,16">
        <StackPanel>
          <TextBlock Text="กำลังใช้งาน" FontWeight="SemiBold" />
          <TextBlock Name="Sources" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <TextBlock Name="Empty" Style="{StaticResource HelpTextStyle}" Text="ยังไม่ได้นำเข้าแพ็กเกจ" />
      <TabControl Name="Packages" MinHeight="180" />
      <TextBlock Name="Status" Style="{StaticResource HelpTextStyle}" Margin="0,12,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
