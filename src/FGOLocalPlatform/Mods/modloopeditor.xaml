<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FGOLocalPlatform.ModLoopEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FGOLocalPlatform" Title="Waveform and loop" Width="1080" Height="760" MinWidth="900" MinHeight="700" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,8,6" />
    </Style>
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Hint" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HelpTextStyle}">
      <Setter Property="Margin" Value="0,6,0,6" />
    </Style>
    <SolidColorBrush x:Key="BeginBrush" Color="#C4B5FD" />
    <SolidColorBrush x:Key="EndBrush" Color="#E9D5FF" />
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Name="TrackTitle" Style="{StaticResource SectionTitleStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />
    <StackPanel Grid.Row="1" Margin="0,0,0,6">
      <WrapPanel>
        <Button Content="Zoom in" Click="ZoomIn" />
        <Button Content="Zoom out" Click="ZoomOut" />
        <Button Content="Whole track" Click="ShowFull" />
        <Button Content="The loop" Click="ShowLoop" />
      </WrapPanel>
      <TextBlock Text="Scroll to zoom. Drag the start and end markers or their sliders; Left and Right nudge them." Style="{StaticResource Hint}" />
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource LineHighBrush}" BorderThickness="1" Background="{StaticResource PlateLowBrush}" CornerRadius="4">
        <local:ModLoopWaveform x:Name="Wave" MinHeight="60" />
      </Border>
      <ScrollBar Name="TimelineScroll" Grid.Row="1" Orientation="Horizontal" Minimum="0" Height="15" Margin="0,8,0,0" ValueChanged="ScrollTimeline" />
    </Grid>
    <Border Name="ControlPanel" Grid.Row="3" Margin="0,8,0,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,2,0,2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Loop start" TextWrapping="Wrap" Foreground="{StaticResource BeginBrush}" VerticalAlignment="Center" />
          <Slider Name="BeginSlider" Grid.Column="1" IsEnabled="False" SmallChange="0.01" LargeChange="1" IsMoveToPointEnabled="True" Margin="4,6,12,6" AutomationProperties.Name="Loop start" ValueChanged="BeginChanged" Thumb.DragStarted="LoopSliderDragStarted" Thumb.DragCompleted="LoopSliderDragCompleted" />
          <TextBlock Name="BeginTime" Grid.Column="2" Foreground="{StaticResource BeginBrush}" VerticalAlignment="Center" TextAlignment="Right" />
          <Button Grid.Column="3" Content="-0.01 s" Margin="12,0,8,0" Click="NudgeBeginBack" />
          <Button Grid.Column="4" Content="+0.01 s" Margin="0" Click="NudgeBeginForward" />
          <TextBlock Grid.Row="1" Text="Loop end" TextWrapping="Wrap" Foreground="{StaticResource EndBrush}" VerticalAlignment="Center" />
          <Slider Name="EndSlider" Grid.Row="1" Grid.Column="1" IsEnabled="False" SmallChange="0.01" LargeChange="1" IsMoveToPointEnabled="True" Margin="4,6,12,6" AutomationProperties.Name="Loop end" ValueChanged="EndChanged" Thumb.DragStarted="LoopSliderDragStarted" Thumb.DragCompleted="LoopSliderDragCompleted" />
          <TextBlock Name="EndTime" Grid.Row="1" Grid.Column="2" Foreground="{StaticResource EndBrush}" VerticalAlignment="Center" TextAlignment="Right" />
          <Button Grid.Row="1" Grid.Column="3" Content="-0.01 s" Margin="12,0,8,0" Click="NudgeEndBack" />
          <Button Grid.Row="1" Grid.Column="4" Content="+0.01 s" Margin="0" Click="NudgeEndForward" />
          <TextBlock Grid.Row="2" Text="Position" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Slider Name="PositionSlider" Grid.Row="2" Grid.Column="1" IsEnabled="False" SmallChange="0.01" LargeChange="1" IsMoveToPointEnabled="True" Margin="4,6,12,6" AutomationProperties.Name="Position" ValueChanged="PositionChanged" Thumb.DragStarted="PositionDragStarted" Thumb.DragCompleted="PositionDragCompleted" />
          <TextBlock Name="PositionTime" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,8,0,4">
          <Button Name="PlayButton" Content="Play or pause" Click="PlayPause" />
          <Button Content="Play from the start" Click="PlayWhole" />
          <Button Content="Stop" Click="StopPlayback" />
          <CheckBox Name="RepeatLoop" Content="Repeat the loop" IsChecked="True" Margin="4,0,16,6" Click="RepeatChanged" />
          <Button Content="Hear the join (last 4 s)" Style="{StaticResource AccentButtonStyle}" Click="PlaySeam" />
          <Button Content="Start here" Click="MarkBegin" />
          <Button Content="End here" Click="MarkEnd" />
          <Button Content="Find a loop" Click="AnalyzeLoop" />
        </WrapPanel>
        <Grid Grid.Row="2" Margin="0,4,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Name="LoopText" />
            <TextBlock Name="Status" Style="{StaticResource Hint}" />
          </StackPanel>
          <TextBlock Name="PlaybackTime" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" />
        </Grid>
      </Grid>
    </Border>
    <DockPanel Grid.Row="4">
      <WrapPanel DockPanel.Dock="Right">
        <Button Content="Cancel" IsCancel="True" Click="Cancel" />
        <Button Name="ApplyButton" Content="Use these loop points" Style="{StaticResource AccentButtonStyle}" Margin="0" Click="ApplyLoop" />
      </WrapPanel>
      <TextBlock Text="Hear the join starts 4 seconds before the end and wraps to the loop start. Play from the start includes the intro. A loop point change keeps the audio as it is." Style="{StaticResource Hint}" />
    </DockPanel>
  </Grid>
</Window>
