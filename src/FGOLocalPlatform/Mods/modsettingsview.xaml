<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.ModSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FGOLocalPlatform">
  <UserControl.Resources>
    <Style x:Key="DialogueToolButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="ModHint" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HelpTextStyle}">
      <Setter Property="Margin" Value="0,6,0,6" />
    </Style>
    <Style x:Key="ModLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style x:Key="UserText" TargetType="{x:Type TextBlock}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="6" />
    </Style>
    <Style TargetType="{x:Type WrapPanel}">
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <Style x:Key="EventItem" TargetType="{x:Type ListBoxItem}">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border Name="ItemBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PlateHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PlateHighBrush}" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource IceBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModList" TargetType="{x:Type ListBox}">
      <Setter Property="Background" Value="{StaticResource PlateLowBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource EventItem}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,12" Text="การเปลี่ยนแปลงของเพลงจะส่งถึงเกมที่กำลังเปิดอยู่ทันทีที่บันทึก ส่วนบทสนทนา ภาพ Master และภาพหน้าโหลดจะมีผลเมื่อเริ่มเกมครั้งถัดไป" />
    <TabControl Name="Tabs" Grid.Row="1">
      <TabItem Name="ImportedTab" Header="Packages">
        <local:ModInstallView x:Name="Installer" />
      </TabItem>
      <TabItem Header="Music">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <CheckBox Name="Bgm" Content="เล่นเพลงของฉัน" />
            <TextBlock Text="แทร็กของกลุ่มเพลงที่ใช้ร่วมกันและของกลุ่มเพลงประจำฉากจะถูกสุ่มเลือกรวมกัน ส่วนกลุ่มเพลงของทุกการต่อสู้จะมาก่อนกลุ่มเพลงของแทร็กเกมที่ถูกแทนที่" Style="{StaticResource ModHint}" />
          </StackPanel>
          <StackPanel Grid.Row="1">
            <ComboBox Name="Pool" MaxDropDownHeight="360" Margin="0,6,0,0" AutomationProperties.Name="กลุ่มเพลง" SelectionChanged="PoolChanged" />
            <WrapPanel>
              <Button Content="ดูว่าเกมเล่นที่ไหน" Margin="0,0,8,0" Click="ShowBgmUsage" />
              <Button Content="ส่งออกรายการการใช้งาน" Click="ExportBgmUsage" />
            </WrapPanel>
          </StackPanel>
          <DataGrid Name="Tracks" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Margin="0,10" HeadersVisibility="Column" MinHeight="120" MouseDoubleClick="OpenLoopEditor">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="แทร็ก" Width="*" MinWidth="220">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource UserText}" Text="{Binding Title}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="จุดเริ่มลูป (วิ)" Width="120" Binding="{Binding LoopBegin}" />
              <DataGridTextColumn Header="จุดสิ้นสุดลูป (วิ)" Width="120" Binding="{Binding LoopEnd}" />
              <DataGridTextColumn Header="เกน (dB)" Width="100" Binding="{Binding GainDb, StringFormat=F2}" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="3">
            <CheckBox Name="AutoLoudness" Content="ปรับความดังให้เท่ากับแทร็กของเกมเองในกลุ่มเพลงนี้" IsChecked="True" />
            <TextBlock Name="ConverterNote" Style="{StaticResource ModHint}" Visibility="Collapsed" />
            <WrapPanel>
              <Button Name="ImportMusicButton" Content="เพิ่มเพลง" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" Click="ImportMusic" />
              <Button Content="คลื่นเสียงและลูป" Margin="0,0,8,0" Click="OpenLoopEditor" />
              <Button Content="ปรับความดังให้เท่ากัน" Margin="0,0,8,0" IsEnabled="{Binding IsChecked, ElementName=AutoLoudness}" Click="UpdateLoudness" />
              <Button Content="ลบแทร็ก" Margin="0,0,8,0" Click="RemoveTrack" />
              <Button Content="บันทึกเพลง" Click="SaveAudioLive" />
            </WrapPanel>
            <TextBlock Text="ดับเบิลคลิกแทร็กเพื่อเปิดคลื่นเสียง ลากกำหนดลูป แล้วฟังดูได้เลย จุดลูปที่พบตอนนำเข้าเป็นเพียงการเดาเบื้องต้น ส่วนจุดที่คุณตั้งเองจะมาก่อน" Style="{StaticResource ModHint}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Name="DialogueTab" Header="Dialogue">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <CheckBox Name="Dialogue" Content="เล่นบทสนทนาของฉัน" HorizontalAlignment="Left" />
          <WrapPanel Grid.Row="1" Margin="0,8,0,10">
            <ComboBox Name="TargetKind" Width="140" Margin="0,0,8,6" AutomationProperties.Name="เป้าหมาย" SelectionChanged="TargetKindChanged">
              <ComboBoxItem Content="เควสต์" />
              <ComboBoxItem Content="แบนเนอร์อีเวนต์" />
            </ComboBox>
            <Grid Width="140" Margin="0,0,8,6">
              <TextBox Name="QuestSearch" ToolTip="ค้นหาตามชื่อหรือหมายเลข" AutomationProperties.Name="ค้นหา" TextChanged="FilterTargets" />
              <TextBlock Name="QuestSearchHint" Text="Search" Margin="12,0,0,0" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <ComboBox Name="Quest" Width="300" Margin="0,0,8,6" MaxDropDownHeight="360" AutomationProperties.Name="เควสต์หรือแบนเนอร์" SelectionChanged="QuestChanged" />
            <ComboBox Name="Trigger" Width="200" Margin="0,0,8,6" SelectedValuePath="Tag" AutomationProperties.Name="เมื่อใด" />
            <ComboBox Name="Repeat" Width="170" Margin="0,0,8,6" AutomationProperties.Name="ความถี่">
              <ComboBoxItem Content="ทุกครั้ง" />
              <ComboBoxItem Content="ครั้งแรกต่อบัญชี" />
            </ComboBox>
            <Button Content="เพิ่มทริกเกอร์" Margin="0,0,8,6" Click="AddEvent" />
            <Button Content="อัปเดตทริกเกอร์" Margin="0,0,0,6" Click="UpdateEvent" />
          </WrapPanel>
          <Expander Grid.Row="2" Header="หลังบทสนทนา" Margin="0,0,0,10" HorizontalContentAlignment="Stretch">
            <StackPanel>
              <WrapPanel>
                <CheckBox Name="ContinueScreen" Content="Tap to continue" Margin="0,0,12,0" Click="ContinueOptionsChanged" />
                <CheckBox Name="ContinueCustomImage" Content="แสดงภาพของฉันเอง" Margin="0,0,12,0" Click="ContinueOptionsChanged" />
                <Button Content="เลือกภาพ" Margin="0,0,8,0" Click="ImportContinueImage" />
                <Button Content="ดูตัวอย่าง" Click="PreviewContinueImage" />
              </WrapPanel>
              <TextBlock Name="ContinueImageInfo" Style="{StaticResource ModHint}" Text="ตั้งค่าให้ทริกเกอร์ที่เลือกทางซ้าย หากไม่มีภาพของคุณเอง หน้าจอจะเป็นสีดำ" />
            </StackPanel>
          </Expander>
          <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
              <WrapPanel HorizontalAlignment="Left" Margin="0">
                <CheckBox Name="LoadingEnabled" Content="ภาพหน้าโหลดของฉัน" VerticalAlignment="Center" Margin="0,0,12,0" Click="LoadingChanged" />
                <Button Content="เลือกภาพ" Style="{StaticResource DialogueToolButton}" Click="ImportLoadingImage" />
                <Button Content="ดูตัวอย่าง" Style="{StaticResource DialogueToolButton}" Click="PreviewLoadingImage" />
                <Button Content="บันทึกภาพหน้าโหลด" Style="{StaticResource DialogueToolButton}" Margin="0" Click="SaveLoadingImages" />
                <Image Name="LoadingPreview" Width="64" Height="36" Stretch="Uniform" Margin="12,0,0,0">
                  <Image.Style>
                    <Style TargetType="{x:Type Image}">
                      <Style.Triggers>
                        <Trigger Property="Source" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Image.Style>
                </Image>
              </WrapPanel>
              <TextBlock Name="LoadingInfo" Style="{StaticResource ModHint}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="210" MinWidth="150" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" MinWidth="300" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="240" MinWidth="160" />
            </Grid.ColumnDefinitions>
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="ทริกเกอร์" Style="{StaticResource ModLabel}" Margin="0,0,0,6" />
              <Button DockPanel.Dock="Bottom" Content="ลบทริกเกอร์" Margin="0,8,0,0" Click="RemoveEvent" />
              <ListBox Name="Events" Style="{StaticResource ModList}" AutomationProperties.Name="ทริกเกอร์" SelectionChanged="EventChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{StaticResource LineBrush}" />
            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="100" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="บทพูดตามลำดับ" Style="{StaticResource ModLabel}" Margin="0,0,0,6" />
                <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <StackPanel Orientation="Horizontal">
                    <Button Content="เพิ่มบทพูด" Style="{StaticResource DialogueToolButton}" Click="AddLine" />
                    <Button Content="คัดลอกบทพูด" Style="{StaticResource DialogueToolButton}" Click="DuplicateLine" />
                    <Button Content="ขึ้น" Style="{StaticResource DialogueToolButton}" Click="MoveUp" />
                    <Button Content="ลง" Style="{StaticResource DialogueToolButton}" Click="MoveDown" />
                    <Button Content="ลบบทพูด" Style="{StaticResource DialogueToolButton}" Margin="0" Click="RemoveLine" />
                  </StackPanel>
                </ScrollViewer>
              </StackPanel>
              <DataGrid Name="Lines" Grid.Row="1" CanUserResizeColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="All" RowHeaderWidth="38" AllowDrop="True" Loaded="StyleDialogueCorner" SizeChanged="FitDialogueColumns" SelectionChanged="LineChanged" LoadingRow="NumberRow" PreviewMouseLeftButtonDown="StartDrag" PreviewMouseMove="DragLine" Drop="DropLine" PreviewDragOver="ScrollDrag" PreviewDragLeave="LeaveDrag">
                <DataGrid.RowHeaderStyle>
                  <Style TargetType="{x:Type DataGridRowHeader}">
                    <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridRowHeader}">
                          <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,1" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </DataGrid.RowHeaderStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="ชื่อ" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource UserText}" Text="{Binding Name}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox AcceptsReturn="False" TextWrapping="Wrap" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="บทพูด" Width="*" MinWidth="160">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource UserText}" Text="{Binding Text}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Grid.Row="2" Text="ลากบทพูดตามหมายเลขเพื่อย้าย รายการจะเลื่อนเองเมื่อลากไปใกล้ขอบ" Style="{StaticResource ModHint}" />
            </Grid>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" Background="{StaticResource LineBrush}" />
            <Grid Grid.Column="4" Margin="10,0,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Image Name="PortraitPreview" Stretch="Uniform" />
              <TextBlock Name="PortraitInfo" Grid.Row="1" Style="{StaticResource ModHint}" HorizontalAlignment="Center" />
            </Grid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Name="PortraitLibraryTab" Header="Portraits">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="โฟลเดอร์ภาพตัวละคร" Style="{StaticResource ModLabel}" Margin="0,0,0,6" />
            <Grid>
              <TextBox Name="LibraryPath" ToolTip="โฟลเดอร์ของคุณเอง ถ้าเว้นว่างจะใช้โฟลเดอร์ใน App\1_MOD" AutomationProperties.Name="โฟลเดอร์ภาพตัวละคร" TextChanged="LibraryPathChanged" />
              <TextBlock Name="LibraryPathHint" Text="Empty uses App\1_MOD" Margin="12,0,0,0" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <WrapPanel>
              <Button Content="ใช้โฟลเดอร์นี้" Margin="0,0,8,0" Click="UseLibrary" />
              <Button Content="เปิดโฟลเดอร์" Click="OpenLibrary" />
            </WrapPanel>
            <TextBlock Text="โฟลเดอร์ของคุณเองใช้ร่วมกับม็อดหลายตัวได้ การส่งออกจะรวมภาพตัวละครที่บทพูดใช้ไปด้วย" Style="{StaticResource ModHint}" />
          </StackPanel>
          <TextBlock Grid.Row="1" Text="เลือกภาพตัวละครเพื่อเปลี่ยนชื่อ ส่วนภาพตัวละครของแต่ละบทพูดให้เลือกในหน้าต่างที่เปิดจากแท็บ Dialogue" Style="{StaticResource ModHint}" />
          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="210" />
              <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <ListBox Name="LibraryItems" Style="{StaticResource ModList}" AutomationProperties.Name="ภาพตัวละคร" SelectionChanged="LibraryChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextWrapping="Wrap" Margin="4" Text="{Binding}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="16,0,0,0">
                <TextBlock Text="ชื่อภาพตัวละคร" Style="{StaticResource ModLabel}" Margin="0,0,0,6" />
                <TextBox Name="PortraitName" AutomationProperties.Name="ชื่อภาพตัวละคร" />
                <TextBlock Name="LibraryReference" Style="{StaticResource ModHint}" />
                <WrapPanel>
                  <Button Content="เปลี่ยนชื่อ" Margin="0,0,8,6" Click="RenamePortrait" />
                  <Button Content="เพิ่มภาพ" Margin="0,0,8,6" Click="ImportPortrait" />
                  <Button Content="ลบ" Style="{StaticResource DestructiveButtonStyle}" Margin="0,0,0,6" Click="RemovePortrait" />
                </WrapPanel>
                <Image Name="LibraryPreview" Width="160" Height="180" Stretch="Uniform" Margin="0,12" />
                <TextBlock Text="ไฟล์ PNG จะกลายเป็นภาพตัวละครของคุณเองข้างภาพตัวละครของเกม โดยจะถูกปรับให้พอดีกับกรอบบทสนทนาและคงสัดส่วนกับความโปร่งใสไว้" Style="{StaticResource ModHint}" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Name="MasterTab" Header="Master">
        <local:ModMasterView x:Name="MasterEditor" />
      </TabItem>
      <TabItem Header="Export">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,0,0" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="เพลง บทสนทนา และภาพ Master จะถูกส่งออกเป็นแพ็กเกจแยกกัน" Style="{StaticResource ModHint}" Margin="0,0,0,6" />
            <TextBlock Text="ชื่อ" Style="{StaticResource ModLabel}" />
            <TextBox Name="PackageTitle" MinWidth="500" AutomationProperties.Name="ชื่อ" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="ผู้จัดทำ" Style="{StaticResource ModLabel}" />
                <TextBox Name="PackageAuthor" AutomationProperties.Name="ผู้จัดทำ" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="เวอร์ชัน" Style="{StaticResource ModLabel}" />
                <TextBox Name="PackageVersion" AutomationProperties.Name="เวอร์ชัน" />
              </StackPanel>
            </Grid>
            <TextBlock Text="คำอธิบาย" Style="{StaticResource ModLabel}" />
            <TextBox Name="PackageDescription" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" VerticalContentAlignment="Top" AutomationProperties.Name="คำอธิบาย" />
            <WrapPanel Margin="0,20,0,8">
              <Button Content="ส่งออกเพลง" Margin="0,0,12,8" ToolTip="เฉพาะกลุ่มเพลง ลูปของกลุ่มเพลง และไฟล์เพลงเท่านั้น" Click="ExportAudio" />
              <Button Content="ส่งออกบทสนทนา" Margin="0,0,12,8" ToolTip="เฉพาะทริกเกอร์ บทพูด ภาพตัวละครที่ใช้ และไฟล์ที่สร้างแล้วเท่านั้น" Click="ExportDialogue" />
              <Button Content="ส่งออกภาพ Master" Margin="0,0,0,8" Click="ExportMaster" />
            </WrapPanel>
            <Button Content="เปิดโฟลเดอร์ม็อด" HorizontalAlignment="Left" Click="OpenFolder" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="บันทึกและสร้าง" Click="Save">
        <Button.Style>
          <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="{x:Type Button}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsSelected, ElementName=ImportedTab}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <TextBlock Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" Margin="0,0,16,0" />
    </DockPanel>
  </Grid>
</UserControl>
