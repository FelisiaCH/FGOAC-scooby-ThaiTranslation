<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.AudioSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="ระดับเสียงในเกม" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
      <TextBlock Text="ตั้งค่าเสียงพากย์ เพลงประกอบ และเสียงเอฟเฟกต์แยกกันได้ การลากแถบเลื่อนจะบันทึกค่าให้ทันที และการเปลี่ยนแปลงจะมีผลทันทีขณะเกมกำลังทำงาน" Style="{StaticResource HelpTextStyle}" Margin="0,0,0,24" />
      <Grid MinWidth="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="64" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="64" />
          <RowDefinition Height="64" />
          <RowDefinition Height="64" />
        </Grid.RowDefinitions>
        <TextBlock Text="เสียงพากย์" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <Slider Name="VoiceSlider" AutomationProperties.Name="Voice volume" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,20,0" ValueChanged="Volume_OnChanged" />
        <TextBlock Grid.Column="2" FontFamily="{StaticResource DigitFont}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Value, ElementName=VoiceSlider, StringFormat={}{0:0}}" />
        <TextBlock Text="เพลงประกอบ" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <Slider Name="BgmSlider" AutomationProperties.Name="BGM volume" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,20,0" ValueChanged="Volume_OnChanged" />
        <TextBlock Grid.Row="1" Grid.Column="2" FontFamily="{StaticResource DigitFont}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Value, ElementName=BgmSlider, StringFormat={}{0:0}}" />
        <TextBlock Text="เสียงเอฟเฟกต์" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <Slider Name="EffectsSlider" AutomationProperties.Name="Effects volume" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,20,0" ValueChanged="Volume_OnChanged" />
        <TextBlock Grid.Row="2" Grid.Column="2" FontFamily="{StaticResource DigitFont}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Value, ElementName=EffectsSlider, StringFormat={}{0:0}}" />
      </Grid>
      <WrapPanel Margin="0,24,0,16">
        <Button Content="ปิดเสียงทั้งหมด" Width="150" Margin="0,0,8,0" Click="Mute_OnClick" />
        <Button Content="คืนค่าเริ่มต้น" Width="150" Click="Defaults_OnClick" />
      </WrapPanel>
      <StackPanel Name="OutputChannelsRow" Visibility="Collapsed" Margin="0,0,0,24">
        <TextBlock Text="Output" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
        <ComboBox Name="OutputChannelsComboBox" Width="420" HorizontalAlignment="Left" AutomationProperties.Name="Output channels" SelectionChanged="OutputChannels_OnChanged">
          <ComboBoxItem Content="2 channels: headphones and stereo speakers" Tag="2" />
          <ComboBoxItem Content="4 channels: front left, front right, back left, back right" Tag="4" />
        </ComboBox>
        <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,8,0,0" Text="Takes effect the next time the game starts. 4 channels keeps the game's own four and lets Windows fit them to your speakers; a stereo device mixes them down." />
      </StackPanel>
      <TextBlock Name="StatusText" Style="{StaticResource HelpTextStyle}" />
      <TextBlock Text="0 คือเงียบสนิท และ 100 คือระดับเสียงต้นฉบับ ค่านี้ไม่มีผลต่อระดับเสียงหลักของ Windows หรือโปรแกรมอื่น เสียงที่ถูกผสมรวมกันไว้แล้วในวิดีโอจะแยกออกจากกันอีกไม่ได้" Style="{StaticResource HelpTextStyle}" Margin="0,16,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>