<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.BattleEffectsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left">
    <CheckBox Name="HideNpScreenBox" Content="ซ่อนหน้าจอมืดหรือขาวระหว่าง Noble Phantasm" AutomationProperties.Name="Hide the dark or white screen during Noble Phantasms" HorizontalAlignment="Left" Margin="0,0,0,4" Checked="Box_OnChanged" Unchecked="Box_OnChanged" />
    <TextBlock Text="การต่อสู้จะคงสีเต็มระหว่างที่ Noble Phantasm ทำงาน" Style="{StaticResource HelpTextStyle}" Margin="3,0,0,16" />
    <CheckBox Name="HideWhiteFlashBox" Content="ซ่อนแสงวาบสีขาวเต็มหน้าจอ" AutomationProperties.Name="Hide the white screen flash" HorizontalAlignment="Left" Margin="0,0,0,4" Checked="Box_OnChanged" Unchecked="Box_OnChanged" />
    <TextBlock Text="เกมจะไม่วาดการเฟดสีขาวเต็มหน้าจอ ไม่ว่าตรงไหนในเกม" Style="{StaticResource HelpTextStyle}" Margin="3,0,0,16" />
    <Grid HorizontalAlignment="Left" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="55" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="ความทึบของเอฟเฟกต์" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
      <Slider Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="Effect opacity" ValueChanged="Opacity_OnChanged" />
      <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}" />
    </Grid>
    <TextBlock Name="OpacityHookNote" Text="โฟลเดอร์เกมนี้มีอัปเดตรุ่นเก่าของ Cloud23333 ซึ่งไม่สนใจการตั้งค่านี้ ต้องใช้อัปเดตล่าสุดของเขาจึงจะอ่านค่านี้" Style="{StaticResource HelpTextStyle}" Foreground="{StaticResource WarnBrush}" Margin="3,0,0,4" Visibility="Collapsed" />
    <TextBlock Text="ความแรงในการวาดเอฟเฟกต์การต่อสู้ของเกม (แสงวาบ การปรับโทนสี) 100 คือหน้าตาเดิมของเกม" Style="{StaticResource HelpTextStyle}" Margin="3,0,0,16" />
    <TextBlock Name="StatusText" TextWrapping="Wrap" Margin="3,0,0,8" Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />
    <TextBlock Text="หน้าตาเดิมของเกมคือปิดทั้งสองสวิตช์และความทึบ 100% การเปลี่ยนแปลงมีผลเมื่อกดเล่นครั้งถัดไป" Style="{StaticResource HelpTextStyle}" Margin="3,0,0,0" />
  </StackPanel>
</UserControl>
