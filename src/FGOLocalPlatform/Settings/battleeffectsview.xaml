<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.BattleEffectsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left">
    <CheckBox Name="HideNpScreenBox" Content="Hide the dark or white screen during Noble Phantasms" AutomationProperties.Name="Hide the dark or white screen during Noble Phantasms" HorizontalAlignment="Left" Margin="0,0,0,4" Checked="Box_OnChanged" Unchecked="Box_OnChanged" />
    <TextBlock Text="The battle stays in full colour while a Noble Phantasm plays." Style="{StaticResource HelpTextStyle}" Margin="3,0,0,16" />
    <CheckBox Name="HideWhiteFlashBox" Content="Hide the white screen flash" AutomationProperties.Name="Hide the white screen flash" HorizontalAlignment="Left" Margin="0,0,0,4" Checked="Box_OnChanged" Unchecked="Box_OnChanged" />
    <TextBlock Text="The game's full-screen white fade is not drawn, anywhere in the game." Style="{StaticResource HelpTextStyle}" Margin="3,0,0,16" />
    <Grid HorizontalAlignment="Left" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="55" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Effect opacity" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
      <Slider Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="Effect opacity" ValueChanged="Opacity_OnChanged" />
      <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}" />
    </Grid>
    <TextBlock Name="OpacityHookNote" Text="This game folder has an older update from Cloud23333, which ignores this setting; his latest update reads it." Style="{StaticResource HelpTextStyle}" Foreground="{StaticResource WarnBrush}" Margin="3,0,0,4" Visibility="Collapsed" />
    <TextBlock Text="How strongly the game's own battle effects (flashes, tints) are drawn, 100 the game's own look." Style="{StaticResource HelpTextStyle}" Margin="3,0,0,16" />
    <TextBlock Name="StatusText" TextWrapping="Wrap" Margin="3,0,0,8" Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />
    <TextBlock Text="The game's own look is both switches off and the opacity at 100%. A change takes effect the next time you press Play." Style="{StaticResource HelpTextStyle}" Margin="3,0,0,0" />
  </StackPanel>
</UserControl>
