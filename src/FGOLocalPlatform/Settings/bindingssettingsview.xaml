<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.BindingsSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FGOLocalPlatform">
  <StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left">
    <WrapPanel>
      <TextBlock Text="โปรไฟล์" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSoftBrush}" />
      <ComboBox Name="ProfileSelector" Width="320" SelectedIndex="0" AutomationProperties.Name="Bindings profile" SelectionChanged="Profile_OnChanged">
        <ComboBoxItem Content="คีย์บอร์ดและเมาส์" Tag="keyboard+mouse" />
        <ComboBoxItem Content="คอนโทรลเลอร์" Tag="pad" />
      </ComboBox>
    </WrapPanel>
    <TextBlock Text="แต่ละแถวคือปุ่มบนหน้าจอของเกม ผูกปุ่มคีย์บอร์ด ปุ่มคอนโทรลเลอร์ หรือชุดปุ่มผสม (chord) เข้ากับแถวนั้น แล้วการกดปุ่มที่ผูกไว้จะแตะปุ่มนั้นขณะที่หน้าต่างเกมอยู่ด้านหน้า คลิกที่ช่อง แล้วกด: กด Ctrl, Shift หรือ Alt ค้างไว้ก่อนเพื่อทำชุดปุ่มผสม หรือกดปุ่มคอนโทรลเลอร์หลายปุ่มพร้อมกัน กด Esc เพื่อยกเลิก ปุ่มที่การ์ดอินพุตใช้อยู่แล้วจะผูกที่นี่ไม่ได้ โปรไฟล์จะเลือกว่าคอลัมน์ไหนทำงาน การเปลี่ยนแปลงบันทึกทันทีและมีผลเมื่อกดเล่นครั้งถัดไป" Style="{StaticResource HelpTextStyle}" Margin="3,8,0,16" />
    <Grid Name="BindingRows">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="80" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="80" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="34" />
      </Grid.RowDefinitions>
      <TextBlock Text="ปุ่ม" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
      <TextBlock Grid.Column="1" Text="คีย์บอร์ดและเมาส์" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
      <TextBlock Grid.Column="3" Text="คอนโทรลเลอร์" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
    </Grid>
    <TextBlock Name="StatusText" TextWrapping="Wrap" Margin="3,8,0,0" Foreground="{StaticResource IceBrush}" />
  </StackPanel>
</UserControl>
