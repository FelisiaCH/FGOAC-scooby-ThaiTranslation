<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.PcPlaySettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left">
    <ToggleButton Name="NoContinueTimerSwitch" Style="{StaticResource SwitchToggleStyle}" Content="ไม่มีตัวนับถอยหลังคอนทินิว" AutomationProperties.Name="No continue countdown" HorizontalAlignment="Left" MinWidth="210" Margin="0,0,0,4" Checked="Switch_OnChanged" Unchecked="Switch_OnChanged" />
    <TextBlock Text="หลังแพ้เควสต์ ปุ่ม Continue และ Withdraw จะรอคุณ โดยไม่มีตัวนับถอยหลังและไม่มีบรรทัด GP" Style="{StaticResource HelpTextStyle}" Margin="3,0,0,16" />
    <ToggleButton Name="NoPopupTimersSwitch" Style="{StaticResource SwitchToggleStyle}" Content="ไม่มีตัวนับถอยหลังป๊อปอัป" AutomationProperties.Name="No popup countdowns" HorizontalAlignment="Left" MinWidth="210" Margin="0,0,0,4" Checked="Switch_OnChanged" Unchecked="Switch_OnChanged" />
    <TextBlock Text="ป๊อปอัปจะเปิดค้างไว้จนกว่าคุณจะตอบ" Style="{StaticResource HelpTextStyle}" Margin="3,0,0,16" />
    <ToggleButton Name="NoGpPurchaseSwitch" Style="{StaticResource SwitchToggleStyle}" Content="ไม่มีหน้าจอซื้อ GP" AutomationProperties.Name="No GP purchase screen" HorizontalAlignment="Left" MinWidth="210" Margin="0,0,0,4" Checked="Switch_OnChanged" Unchecked="Switch_OnChanged" />
    <TextBlock Text="ทุกครั้งที่เล่นจะเริ่มโดยไม่มีหน้าจอซื้อ GP ฟีเจอร์ทดลอง ปิดไว้เป็นค่าเริ่มต้น" Style="{StaticResource HelpTextStyle}" Margin="3,0,0,16" />
    <ToggleButton Name="NoStoryTimerSwitch" Style="{StaticResource SwitchToggleStyle}" Content="หน้าเนื้อเรื่องรอคุณ" AutomationProperties.Name="Story pages wait for you" HorizontalAlignment="Left" MinWidth="210" Margin="0,0,0,4" Checked="Switch_OnChanged" Unchecked="Switch_OnChanged" />
    <TextBlock Text="หน้าเนื้อเรื่องที่มีเวลาจะรอการคลิก, Space หรือปุ่ม A ของแพด ฟีเจอร์ทดลอง ปิดไว้เป็นค่าเริ่มต้น" Style="{StaticResource HelpTextStyle}" Margin="3,0,0,16" />
    <ToggleButton Name="NoMenuTimerSwitch" Style="{StaticResource SwitchToggleStyle}" Content="ไม่มีตัวนับถอยหลังเมนู" AutomationProperties.Name="No menu countdown" HorizontalAlignment="Left" MinWidth="210" Margin="0,0,0,4" Checked="Switch_OnChanged" Unchecked="Switch_OnChanged" />
    <TextBlock Text="ตัวนับถอยหลัง Time Remaining ในเมนูจะหยุด เกมจึงไม่กลับไปหน้าไตเติลเอง ฟีเจอร์ทดลอง ปิดไว้เป็นค่าเริ่มต้น" Style="{StaticResource HelpTextStyle}" Margin="3,0,0,16" />
    <TextBlock Text="การเปลี่ยนแปลงมีผลเมื่อกดเล่นครั้งถัดไป" Style="{StaticResource HelpTextStyle}" Margin="3,0,0,0" />
  </StackPanel>
</UserControl>
