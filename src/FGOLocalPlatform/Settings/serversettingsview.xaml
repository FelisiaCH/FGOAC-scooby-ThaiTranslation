<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.ServerSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform" Loaded="View_OnLoaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" Text="ที่อยู่ auto จะเชื่อมไปยังเซิร์ฟเวอร์บนเครื่องนี้และใช้ได้โดยไม่ต้องมีอินเทอร์เน็ต ใส่ที่อยู่ IPv4 อื่นเพื่อใช้เซิร์ฟเวอร์ระยะไกลแทน" />
      <Grid>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="TextBox.TextAlignment" Value="Center" />
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" />
          <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="52" />
          <RowDefinition Height="52" />
          <RowDefinition Height="52" />
          <RowDefinition Height="52" />
          <RowDefinition Height="52" />
        </Grid.RowDefinitions>
        <TextBlock Text="ที่อยู่เซิร์ฟเวอร์ (auto คือเครื่องนี้)" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="HostBox" AutomationProperties.Name="Server address" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
        <TextBlock Text="พอร์ต Title (เข้าสู่ระบบเกม)" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="HttpBox" AutomationProperties.Name="Title port" Grid.Row="1" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
        <TextBlock Text="พอร์ต Billing (ปลอดภัย)" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="BillingBox" AutomationProperties.Name="Billing port" Grid.Row="2" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
        <TextBlock Text="พอร์ตเครื่องอ่านการ์ด" Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="AimeBox" AutomationProperties.Name="Card reader port" Grid.Row="3" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
        <TextBlock Text="พอร์ตฐานข้อมูลในเครื่อง" Grid.Row="4" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="DatabaseBox" AutomationProperties.Name="Local database port" Grid.Row="4" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
      </Grid>
      <WrapPanel Margin="0,16,0,16">
        <Button Content="บันทึกการตั้งค่า" Width="160" Padding="12,6" Margin="0,0,8,0" Click="Configure_OnClick" />
        <Button Content="คืนค่าเริ่มต้น" Width="160" Padding="12,6" Margin="0,0,8,0" Click="Defaults_OnClick" />
        <Button Content="รีเฟรชสถานะ" Width="160" Padding="12,6" Click="Refresh_OnClick" />
      </WrapPanel>
      <TextBlock Text="พอร์ตต้องเป็นจำนวนเต็มตั้งแต่ 1 ถึง 65535 และห้ามมีสองบริการใช้พอร์ตเดียวกัน การบันทึกจะหยุดเซิร์ฟเวอร์ในเครื่อง จึงควรออกจากเกมก่อน ทั้งการบันทึกและการเปิดหน้านี้ไม่ได้เริ่มเซิร์ฟเวอร์ ปุ่ม คืนค่าเริ่มต้น เพียงเติมค่าลงในช่องเท่านั้น - ให้คลิก บันทึกการตั้งค่า เพื่อนำไปใช้จริง" Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" />
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource PlateBrush}" Padding="14">
        <TextBlock Name="InfoText" Text="กำลังอ่านการตั้งค่า..." TextWrapping="Wrap" LineHeight="24" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>