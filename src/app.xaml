<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="FGOLocalPlatform.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FGOLocalPlatform">
  <Application.Resources>
    <ResourceDictionary>

      <!-- Surfaces: page, card one step lighter, raised one step lighter again; hairlines at 6 percent white. -->
      <SolidColorBrush x:Key="GroundBrush" Color="#16181D" />
      <SolidColorBrush x:Key="PlateBrush" Color="#1E2127" />
      <SolidColorBrush x:Key="PlateHighBrush" Color="#262A31" />
      <SolidColorBrush x:Key="PlateHoverBrush" Color="#2E323A" />
      <SolidColorBrush x:Key="PlateLowBrush" Color="#121418" />
      <SolidColorBrush x:Key="LineBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="LineSoftBrush" Color="#0AFFFFFF" />
      <SolidColorBrush x:Key="LineHighBrush" Color="#24FFFFFF" />

      <SolidColorBrush x:Key="TextBrush" Color="#E6E6E3" />
      <SolidColorBrush x:Key="TextSoftBrush" Color="#8B8F98" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="#686C75" />

      <!-- The one accent, violet: the primary action, selection, focus, links and the ready state. The Ice keys are the names the views use for it. -->
      <SolidColorBrush x:Key="IceBrush" Color="#7C3AED" />
      <SolidColorBrush x:Key="IceDimBrush" Color="#6D28D9" />
      <SolidColorBrush x:Key="IceDeepBrush" Color="#2A2140" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#8B5CF6" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#6D28D9" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#E6E6E3" />

      <!-- Status tags: washed-out pastels on dark tints. -->
      <SolidColorBrush x:Key="DangerBrush" Color="#EBA3A8" />
      <SolidColorBrush x:Key="DangerFillBrush" Color="#2C1C1F" />
      <SolidColorBrush x:Key="DangerEdgeBrush" Color="#4A2B30" />
      <SolidColorBrush x:Key="DangerFillStrongBrush" Color="#361F23" />
      <SolidColorBrush x:Key="DangerEdgeStrongBrush" Color="#5E3238" />
      <SolidColorBrush x:Key="ReadyBrush" Color="#9CD3AE" />
      <SolidColorBrush x:Key="ReadyFillBrush" Color="#1B2A22" />
      <SolidColorBrush x:Key="ReadyEdgeBrush" Color="#2A4234" />
      <SolidColorBrush x:Key="InfoBrush" Color="#9DC4E8" />
      <SolidColorBrush x:Key="InfoFillBrush" Color="#1A2533" />
      <SolidColorBrush x:Key="WarnBrush" Color="#E8CB85" />
      <SolidColorBrush x:Key="WarnFillBrush" Color="#2C2618" />

      <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />

      <FontFamily x:Key="UiFont">./Fonts/#Geist, Leelawadee UI, Yu Gothic UI, Microsoft YaHei UI</FontFamily>
      <FontFamily x:Key="DigitFont">./Fonts/#Geist Mono, Consolas</FontFamily>

      <Geometry x:Key="CheckGeometry">M 0,5 L 4,9 L 11,1</Geometry>
      <Geometry x:Key="ChevronGeometry">M 0,0 L 5,5 L 10,0</Geometry>

      <!-- Shown only when the keyboard put the focus there, never on a click. -->
      <Style x:Key="IceFocusVisual">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Rectangle Margin="-2" RadiusX="9" RadiusY="9" Stroke="{StaticResource IceBrush}" StrokeThickness="2" SnapsToDevicePixels="True" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      </Style>

      <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      </Style>

      <Style x:Key="HelpTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="23" />
      </Style>

      <Style x:Key="SecondaryNameStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
        <Setter Property="ToolTip" Value="ชื่อภาษาญี่ปุ่น ตามที่ตู้เกมพิมพ์ไว้" />
        <Style.Triggers>
          <Trigger Property="Text" Value="">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- A card: one step lighter than the page, hairline rim, 12 px corners, 24 px inside. -->
      <Style x:Key="CardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource PlateBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>

      <!-- The raised surface with a hairline rim; hover is one step lighter, press shrinks it to 98 percent. -->
      <Style TargetType="{x:Type Button}">
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="{StaticResource PlateHighBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IceFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Plate" Property="Background" Value="{StaticResource PlateHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Plate" Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Plate" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- The one solid accent surface on a page or in a dialog: the action it is for. -->
      <Style x:Key="AccentButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource IceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource IceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Plate" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                  <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Plate" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                  <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
                  <Setter TargetName="Plate" Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Plate" Property="Opacity" Value="0.35" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Play. -->
      <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="24,6" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="FontSize" Value="17" />
      </Style>

      <!-- Anything that throws work away. -->
      <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerEdgeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
      </Style>

      <Style x:Key="DestructiveButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerFillStrongBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerEdgeStrongBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
      </Style>

      <Style x:Key="GrantButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource ReadyFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ReadyEdgeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ReadyBrush}" />
      </Style>

      <!-- Text only, no surface until the pointer is over it. -->
      <Style x:Key="QuietButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="30" />
      </Style>

      <!-- A switch: a 34 x 20 track with its knob, then the label; the track takes the accent when on. -->
      <Style x:Key="SwitchToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IceFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="Plate" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Name="Track" Width="34" Height="20" CornerRadius="10" Background="{StaticResource PlateHoverBrush}" BorderBrush="{StaticResource LineHighBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                    <Ellipse Name="Knob" Width="14" Height="14" Margin="2,0" Fill="{StaticResource TextSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                  <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{StaticResource IceBrush}" />
                  <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource IceBrush}" />
                  <Setter TargetName="Knob" Property="Fill" Value="{StaticResource GroundBrush}" />
                  <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Knob" Property="Fill" Value="{StaticResource TextBrush}" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsChecked" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Knob" Property="Fill" Value="{StaticResource GroundBrush}" />
                  <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Plate" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- One half of a two-way switch; the checked half is the raised surface with the accent text. -->
      <Style x:Key="SegmentStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IceFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Border Name="Segment" Background="Transparent" CornerRadius="6" Padding="14,0" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Segment" Property="Background" Value="{StaticResource PlateHoverBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Segment" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- A 2 px line with an accent segment sliding across it; the slide runs only while the line is shown. -->
      <Style x:Key="ThinProgressStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="2" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ProgressBar}">
              <Border Background="{StaticResource LineBrush}" ClipToBounds="True" CornerRadius="1">
                <Border Name="Runner" Width="120" HorizontalAlignment="Left" Background="{StaticResource IceBrush}" CornerRadius="1">
                  <Border.RenderTransform>
                    <TranslateTransform x:Name="RunnerShift" X="-120" />
                  </Border.RenderTransform>
                </Border>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsVisible" Value="True">
                  <Trigger.EnterActions>
                    <BeginStoryboard Name="Slide">
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="RunnerShift" Storyboard.TargetProperty="X" From="-120" To="900" Duration="0:0:1.4" />
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Slide" />
                  </Trigger.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Fields are wells a step darker than the page; the rim takes the accent on focus. -->
      <Style TargetType="{x:Type TextBox}">
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="{StaticResource PlateLowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineHighBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CaretBrush" Value="{StaticResource IceBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource IceDimBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Background="Transparent" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource TextFaintBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource IceBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Field" Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="{StaticResource PlateHighBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Padding" Value="10,7" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PlateHoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource IceDeepBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <Border Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                  <Grid>
                    <ToggleButton Focusable="False" Background="{x:Null}" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                          <Border Background="Transparent">
                            <Path Data="{StaticResource ChevronGeometry}" Width="10" Height="5" Stretch="Fill" Stroke="{StaticResource TextSoftBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                          </Border>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Name="SelectionPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="False" Margin="10,0,30,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                    <TextBox Name="PART_EditableTextBox" Visibility="Hidden" Background="{TemplateBinding Background}" BorderThickness="0" Margin="5,0,30,0" VerticalContentAlignment="Center" Foreground="{StaticResource TextBrush}" IsReadOnly="{TemplateBinding IsReadOnly}" />
                  </Grid>
                </Border>
                <Popup Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                  <Border Background="{StaticResource PlateHighBrush}" BorderBrush="{StaticResource LineHighBrush}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{TemplateBinding ActualWidth}" MaxWidth="{TemplateBinding ActualWidth}" MaxHeight="340">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="Transparent">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource PlateHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource IceBrush}" />
                </Trigger>
                <Trigger Property="IsEditable" Value="True">
                  <Setter TargetName="SelectionPresenter" Property="Visibility" Value="Hidden" />
                  <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="ComboBorder" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- A box and a label on one 32 px row; the box takes the accent when ticked. -->
      <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource PlateLowBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineHighBrush}" />
        <Setter Property="Margin" Value="0,2,16,2" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IceFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <Grid Name="Row" Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Name="Box" Width="18" Height="18" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
                  <Path Name="Tick" Data="{StaticResource CheckGeometry}" Stretch="Uniform" Width="10" Height="9" Stroke="{StaticResource OnAccentBrush}" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Visibility="Collapsed" />
                </Border>
                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" RecognizesAccessKey="True" VerticalAlignment="Center">
                  <ContentPresenter.Resources>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextFaintBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Box" Property="Background" Value="{StaticResource IceBrush}" />
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource IceBrush}" />
                  <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type Slider}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource IceBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Grid Background="Transparent">
                <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{StaticResource PlateHoverBrush}" SnapsToDevicePixels="True" />
                <Track Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                      <RepeatButton.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{StaticResource IceBrush}" />
                        </ControlTemplate>
                      </RepeatButton.Template>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                      <RepeatButton.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="Transparent" />
                        </ControlTemplate>
                      </RepeatButton.Template>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Width="16" Height="16">
                      <Thumb.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Ellipse Name="Grip" Fill="{StaticResource IceBrush}" SnapsToDevicePixels="True" />
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Grip" Property="Fill" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                              <Setter TargetName="Grip" Property="Fill" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- The pivot inside a page: plain text, the selected one underlined in the accent. -->
      <Style TargetType="{x:Type TabItem}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IceFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Grid Name="Tab" Background="Transparent" Height="40" Margin="0,0,24,0">
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" />
                <Border Name="Underline" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Background="{x:Null}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Underline" Property="Background" Value="{StaticResource IceBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Tab" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{StaticResource GroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid Background="{TemplateBinding Background}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="32,0,32,0" SnapsToDevicePixels="True">
                  <TabPanel IsItemsHost="True" HorizontalAlignment="Left" />
                </Border>
                <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- A sidebar row: 40 px; the selected one is the raised surface with a 3 px accent bar, hover one step up. -->
      <Style x:Key="SidebarTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IceFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Grid Height="40" Margin="8,1,8,1">
                <Border Name="Row" Background="Transparent" CornerRadius="8" SnapsToDevicePixels="True" />
                <Border Name="Bar" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-8,0,0,0" Background="Transparent" />
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,12,0" RecognizesAccessKey="True" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{StaticResource PlateBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{StaticResource PlateHighBrush}" />
                  <Setter TargetName="Bar" Property="Background" Value="{StaticResource IceBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                  <Setter Property="FontWeight" Value="Medium" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- The window's own navigation: the 188 px section column on the left, the page on the right. -->
      <Style x:Key="SidebarTabControlStyle" TargetType="{x:Type TabControl}" BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid Background="{TemplateBinding Background}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="188" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" SnapsToDevicePixels="True">
                  <TabPanel IsItemsHost="True" VerticalAlignment="Top" Margin="0,8,0,0" KeyboardNavigation.TabIndex="1" />
                </Border>
                <ContentPresenter Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="{StaticResource GroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      </Style>

      <Style TargetType="{x:Type ListViewItem}">
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListViewItem}">
              <Border Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PlateHighBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource IceDeepBrush}" />
                  <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource IceBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{StaticResource GroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource PlateBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource PlateBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeaderWidth" Value="0" />
      </Style>

      <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource PlateHighBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
      </Style>

      <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PlateHighBrush}" />
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{StaticResource IceDeepBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Width="10" Background="Transparent">
          <Track Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Background="{StaticResource PlateHoverBrush}" MinHeight="36">
                <Thumb.Template>
                  <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Name="ThumbBody" Background="{TemplateBinding Background}" CornerRadius="3" Margin="2,2" />
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource TextFaintBrush}" />
                      </Trigger>
                      <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource TextSoftBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
            </Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate>

      <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Height="10" Background="Transparent">
          <Track Name="PART_Track">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Background="{StaticResource PlateHoverBrush}" MinWidth="36">
                <Thumb.Template>
                  <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Name="ThumbBody" Background="{TemplateBinding Background}" CornerRadius="3" Margin="2,2" />
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource TextFaintBrush}" />
                      </Trigger>
                      <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource TextSoftBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" />
            </Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate>

      <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollViewer}">
              <Grid Background="{TemplateBinding Background}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollContentPresenter Name="PART_ScrollContentPresenter" Grid.Row="0" Grid.Column="0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" />
                <ScrollBar Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <ScrollBar Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource LineBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Separator}">
              <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Expander}">
              <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ToggleButton Name="HeaderButton" MinHeight="38" Cursor="Hand" Focusable="True" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Name="HeaderSurface" Background="Transparent" CornerRadius="8" Padding="14,8">
                          <StackPanel Orientation="Horizontal">
                            <Path Name="Chevron" Data="{StaticResource ChevronGeometry}" Width="10" Height="5" Stretch="Fill" Stroke="{StaticResource TextSoftBrush}" StrokeThickness="1.5" Margin="0,0,11,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource IceBrush}" />
                          </Trigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource PlateHighBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                    <ContentPresenter ContentSource="Header" />
                  </ToggleButton>
                  <Border Name="Body" Grid.Row="1" Visibility="Collapsed" Padding="14,0,14,12">
                    <ContentPresenter />
                  </Border>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource PlateHighBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineHighBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ContextMenu}">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ItemsPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type MenuItem}">
              <Border Name="MenuSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Path Name="Check" Data="{StaticResource CheckGeometry}" Width="11" Height="10" Stretch="Uniform" Stroke="{StaticResource IceBrush}" StrokeThickness="2" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" />
                  <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0" Foreground="{StaticResource TextSoftBrush}" />
                  <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False">
                    <Border Background="{StaticResource PlateHighBrush}" BorderBrush="{StaticResource LineHighBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                      <ItemsPresenter />
                    </Border>
                  </Popup>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="MenuSurface" Property="Background" Value="{StaticResource PlateHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="MenuSurface" Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type ToolTip}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource PlateHighBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineHighBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToolTip}">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter>
                  <ContentPresenter.Resources>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type Window}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Background" Value="{StaticResource GroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
      </Style>

      <Style TargetType="{x:Type UserControl}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
