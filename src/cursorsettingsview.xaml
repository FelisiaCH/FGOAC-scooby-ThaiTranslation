<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.CursorSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <StackPanel Margin="0,4" MaxWidth="900" HorizontalAlignment="Left">
    <TextBlock Text="ตัวชี้เมาส์และเส้นขอบกลับสี" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
    <TextBlock Text="ใช้แทนตัวชี้แบบเป้าเล็งภายในเกม การตั้งค่าเหล่านี้จะถูกบันทึกแยกต่างหาก และจะมีผลเมื่อเริ่มเกมครั้งถัดไป" Style="{StaticResource HelpTextStyle}" />
    <WrapPanel Margin="0,8">
      <ComboBox Name="Mode" Width="170" SelectedIndex="0" SelectionChanged="Settings_OnChanged">
        <ComboBoxItem Content="เป้าเล็งค่าเริ่มต้น" />
        <ComboBoxItem Content="ลูกศรของระบบ" />
        <ComboBoxItem Content="รูปภาพกำหนดเอง" />
      </ComboBox>
      <Button Content="เลือกรูปภาพ..." Margin="8,0" Click="Choose_OnClick" />
    </WrapPanel>
    <TextBlock Name="ImageName" Text="รองรับ PNG แบบโปร่งใส, JPG และ BMP รูปภาพจะถูกคัดลอกไปไว้ในโฟลเดอร์เกม จึงยังใช้งานได้แม้คุณย้ายตำแหน่งที่ติดตั้ง" Style="{StaticResource HelpTextStyle}" />
    <Grid Margin="0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="132" Height="132" Background="{StaticResource PlateLowBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalAlignment="Top">
        <Grid>
          <Image Name="Preview" Stretch="None" />
          <Canvas IsHitTestVisible="False">
            <Ellipse Name="Hotspot" Width="5" Height="5" Fill="{StaticResource IceBrush}" Stroke="{StaticResource TextBrush}" StrokeThickness="1" />
          </Canvas>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <TextBlock Foreground="{StaticResource TextSoftBrush}" Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat=Size: {0:0} px}" />
        <Slider Name="SizeSlider" Minimum="16" Maximum="128" Value="48" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Settings_OnChanged" />
        <TextBlock Foreground="{StaticResource TextSoftBrush}" Text="{Binding ElementName=OutlineSlider, Path=Value, StringFormat=Inverted outline: {0:0} px (0 turns it off)}" />
        <Slider Name="OutlineSlider" Minimum="0" Maximum="6" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Settings_OnChanged" />
        <TextBlock Foreground="{StaticResource TextSoftBrush}" Text="เส้นขอบจะกลับสีของสิ่งที่อยู่ด้านหลังแบบเรียลไทม์ ภาพตัวอย่างใช้ลายตารางหมากรุกสีเข้ม ตัวชี้เองยังคงสีเดิมของรูปภาพ และพื้นที่โปร่งใสจะถูกตัดออกไปตามแนวเส้นขอบ" TextWrapping="Wrap" Margin="0,8" />
      </StackPanel>
    </Grid>
    <TextBlock Text="จุดสีชมพูคือตำแหน่งที่การคลิกตกลงจริง ๆ จุดคลิกกำหนดเป็นเปอร์เซ็นต์ของผืนภาพตัวชี้ โดย 50% คือกึ่งกลาง และ 0% คือมุมบนซ้าย" Style="{StaticResource HelpTextStyle}" />
    <TextBlock Foreground="{StaticResource TextSoftBrush}" Text="{Binding ElementName=HotX, Path=Value, StringFormat=Hotspot X: {0:0}%}" />
    <Slider Name="HotX" Minimum="0" Maximum="100" Value="50" ValueChanged="Settings_OnChanged" />
    <TextBlock Foreground="{StaticResource TextSoftBrush}" Text="{Binding ElementName=HotY, Path=Value, StringFormat=Hotspot Y: {0:0}%}" />
    <Slider Name="HotY" Minimum="0" Maximum="100" Value="50" ValueChanged="Settings_OnChanged" />
    <Button Content="บันทึกการตั้งค่าตัวชี้" HorizontalAlignment="Left" Margin="0,8" Click="Save_OnClick" />
    <TextBlock Name="Status" Foreground="{StaticResource IceBrush}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>