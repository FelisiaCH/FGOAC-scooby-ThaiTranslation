<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.DebugSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="ชุดค่าดีบักการต่อสู้ในเครื่อง ทุกอย่างปิดอยู่ตามค่าเริ่มต้น และจะไม่มีการเขียนข้อมูลลงเซฟบัญชีของคุณ" Style="{StaticResource HelpTextStyle}" Margin="0,0,0,12" />
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource PlateBrush}" Padding="12" Margin="0,0,0,18">
        <TextBlock Text="ความเสียหายคงที่ได้รับการยืนยันแล้วในเกม ส่วนตัวเลือกอื่นจะมีผลประมาณหนึ่งวินาทีหลังจากคุณบันทึก" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
      </Border>
      <TextBlock Text="สูตรโกง" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
      <StackPanel>
            <CheckBox Name="OneHit" Content="ความเสียหายคงที่ 999999" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="ทุกครั้งที่คุณโจมตีโดนจะสร้างความเสียหาย 999999 พอดี ค่า ATK ที่แสดงไว้จะไม่เปลี่ยนแปลง และการปิดตัวเลือกนี้จะคืนความเสียหายกลับเป็นปกติ" Style="{StaticResource HelpTextStyle}" Margin="24,0,0,14" />
            <CheckBox Name="AttackStun" Content="การโจมตีทำให้มึนงง" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="เมื่อโจมตีโดน ระบบจะเรียกใช้อาการมึนงงของตัวเกมเอง โดยยังคงใช้กฎภูมิคุ้มกัน ช่วงเวลาฟื้นตัว และการหมดฤทธิ์ตามปกติทั้งหมด การโจมตีที่ถูกป้องกันหรือพลาดจะไม่ทำให้เกิดผลนี้" Style="{StaticResource HelpTextStyle}" Margin="24,0,0,14" />
            <CheckBox Name="FullNp" Content="คง NP ให้เต็มตลอด" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="คงค่าชาร์จ NP ของเซอร์แวนต์ไว้ที่ระดับสูงสุดที่มีอยู่ในขณะนั้น และเติมกลับให้หลังจากคุณใช้ไปแล้ว" Foreground="{StaticResource TextSoftBrush}" Margin="24,0,0,14" />
            <CheckBox Name="InstantNoble" Content="Noble Phantasm ทันที" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="ข้ามช่วงรอชาร์จ Noble Phantasm ส่วนคัตซีน NP และการคำนวณความเสียหายตามปกติยังคงเดิม" Foreground="{StaticResource TextSoftBrush}" Margin="24,0,0,14" />
            <CheckBox Name="Invincible" Content="อมตะ" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="การโจมตีของศัตรูจะไม่ลด HP ของคุณอีกต่อไป การพ่ายแพ้ตามบทในเนื้อเรื่องยังคงเกิดขึ้น และตัวศัตรูเองไม่ได้ถูกเปลี่ยนแปลง" Foreground="{StaticResource TextSoftBrush}" Margin="24,0,0,14" />
      </StackPanel>
      <WrapPanel Margin="0,18,0,12">
        <Button Content="บันทึก" Width="150" Margin="0,0,8,0" Click="Save_OnClick" />
        <Button Content="ปิดทั้งหมด" Width="150" Click="DisableAll_OnClick" />
      </WrapPanel>
      <TextBlock Name="StatusText" Style="{StaticResource HelpTextStyle}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>