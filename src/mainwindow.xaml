                    </WrapPanel>
                    <WrapPanel Margin="0,12,0,20">
                      <TextBlock Text="จำกัดเฟรมเรต" VerticalAlignment="Center" Margin="0,3,6,3" Foreground="{StaticResource TextSoftBrush}" />
                      <ComboBox Name="FrameRateComboBox" Width="152">
                        <ComboBoxItem Content="60 FPS (เสถียร)" Tag="60" />
                        <ComboBoxItem Content="90 FPS" Tag="90" />
                        <ComboBoxItem Content="120 FPS" Tag="120" />
                        <ComboBoxItem Content="144 FPS" Tag="144" />
                      </ComboBox>
                    </WrapPanel>
                    <TextBlock Text="คุณภาพของภาพ" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                    <WrapPanel Margin="0,0,0,12">
                      <TextBlock Text="การลบรอยหยัก" VerticalAlignment="Center" Margin="0,3,6,3" Foreground="{StaticResource TextSoftBrush}" />
                      <ComboBox Name="SmaaComboBox" Width="232" SelectedIndex="0">
                        <ComboBoxItem Content="ปิด (ความละเอียดดั้งเดิม)" Tag="0" />
                        <ComboBoxItem Content="ความละเอียดดั้งเดิม + SMAA High" Tag="1" />
                        <ComboBoxItem Content="ความละเอียดดั้งเดิม + SMAA Ultra" Tag="2" />
                      </ComboBox>
                      <TextBlock Text="การกรองแบบแอนไอโซทรอปิก" VerticalAlignment="Center" Margin="12,3,6,3" Foreground="{StaticResource TextSoftBrush}" />
                      <ComboBox Name="AnisotropyComboBox" Width="90" SelectedIndex="4">
                        <ComboBoxItem Content="1x" Tag="1" />
                        <ComboBoxItem Content="2x" Tag="2" />
                        <ComboBoxItem Content="4x" Tag="4" />
                        <ComboBoxItem Content="8x" Tag="8" />
                        <ComboBoxItem Content="16x" Tag="16" />
                      </ComboBox>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,12">
                      <TextBlock Text="สเกลการเรนเดอร์" VerticalAlignment="Center" Margin="0,3,6,3" Foreground="{StaticResource TextSoftBrush}" />
                      <ComboBox Name="RenderScaleComboBox" Width="232" SelectedIndex="0">
                        <ComboBoxItem Content="100% (ความละเอียดดั้งเดิม)" Tag="100" />
                        <ComboBoxItem Content="125% (พิกเซล 1.56 เท่า)" Tag="125" />
                        <ComboBoxItem Content="150% (พิกเซล 2.25 เท่า)" Tag="150" />
                        <ComboBoxItem Content="200% (พิกเซล 4 เท่า)" Tag="200" />
                      </ComboBox>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,8" Text="เรนเดอร์ภาพที่ความละเอียดสูงกว่าจอของคุณแล้วย่อกลับลงมา ตัวละครจึงดูคมชัดขึ้นและขอบภาพเนียนขึ้น ขนาด UI และมุมมองภาพไม่เปลี่ยน และใช้ร่วมกับ SMAA ได้" />
                    <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,8" Text="ยิ่งสเกลสูง ยิ่งใช้ GPU มาก หากเกมกระตุกให้ลดค่าลง หาก GPU ของคุณรับค่านี้ไม่ไหว เกมจะกลับไปใช้ 100%" />
                    <WrapPanel Margin="0,4,0,16">
                      <CheckBox Name="MotionBlurCheckBox" Content="ภาพเบลอตามการเคลื่อนไหว" Margin="0,4,24,4" />
                      <CheckBox Name="DepthOfFieldCheckBox" Content="ระยะชัดลึก" IsChecked="True" Margin="0,4,24,4" />
                      <CheckBox Name="BloomCheckBox" Content="แสงฟุ้ง" IsChecked="True" Margin="0,4,24,4" />
                      <CheckBox Name="DisableCameraShakeCheckBox" Content="ปิดการสั่นของกล้อง" Margin="0,4,24,4" ToolTip="เอาเอฟเฟกต์กล้องสั่นของเกมออก โดยไม่กระทบการเคลื่อนกล้องตามปกติ จะมีผลเมื่อเริ่มเกมครั้งถัดไป" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,24" Text="SMAA จะเกลี่ยภาพที่เรนเดอร์เสร็จแล้วให้เนียนขึ้น รวมถึงข้อความ UI ส่วนการกรองแบบแอนไอโซทรอปิกจะทำให้พื้นผิวในฉากที่มองจากมุมเฉียงคมชัดขึ้น" />
                    <WrapPanel Margin="0,0,0,12">
                      <TextBlock Text="ความละเอียดของเงา" VerticalAlignment="Center" Margin="0,3,12,3" Foreground="{StaticResource TextSoftBrush}" />
                      <ComboBox Name="ShadowResolutionComboBox" Width="210" SelectedIndex="0">
                        <ComboBoxItem Content="ค่าเริ่มต้นของเกม" Tag="0" />
                        <ComboBoxItem Content="1024 x 1024" Tag="1024" />
                        <ComboBoxItem Content="2048 x 2048" Tag="2048" />
                        <ComboBoxItem Content="4096 x 4096" Tag="4096" />
                      </ComboBox>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,24" Text="กำหนดความคมชัดของเงาแบบเรียลไทม์ ไม่มีผลกับ ambient occlusion และเงาที่เบกไว้ล่วงหน้า ความละเอียดที่สูงขึ้นใช้หน่วยความจำวิดีโอและเวลาวาดภาพมากขึ้น จะมีผลเมื่อเริ่มเกมครั้งถัดไป" />
                    <CheckBox Name="HideTargetLinesCheckBox" Content="ซ่อนเส้นล็อกเป้าศัตรู" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,20" Text="ซ่อนเฉพาะเส้นเชื่อมเท่านั้น ระบบล็อกเป้าและเครื่องหมายเป้าหมายยังทำงานตามปกติ จะมีผลเมื่อเริ่มเกมครั้งถัดไป" />
                    <TextBlock Text="ป๊อปอัปความเสียหายในการต่อสู้" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                    <Grid MaxWidth="680" HorizontalAlignment="Left" Width="Auto" Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="182" />
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="65" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="44" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="ขนาดตัวเลขความเสียหาย" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
                      <Slider Name="DamageNumberScaleSlider" Grid.Column="1" Minimum="0" Maximum="200" Value="100" SmallChange="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                      <TextBox Grid.Column="2" Margin="8,3,0,3" VerticalContentAlignment="Center" ToolTip="เป็นเปอร์เซ็นต์ ใส่ทศนิยมได้" Text="{Binding Value, ElementName=DamageNumberScaleSlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnExceptions=True}" />
                      <TextBlock Grid.Row="1" Text="ความทึบของตัวเลข" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
                      <Slider Name="DamageNumberOpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="100" SmallChange="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                      <TextBox Grid.Row="1" Grid.Column="2" Margin="8,3,0,3" VerticalContentAlignment="Center" ToolTip="เป็นเปอร์เซ็นต์ ใส่ทศนิยมได้" Text="{Binding Value, ElementName=DamageNumberOpacitySlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnExceptions=True}" />
                      <TextBlock Grid.Row="2" Text="ขนาดภาพป๊อปอัป" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
                      <Slider Name="DamageTextureScaleSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="200" Value="100" SmallChange="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                      <TextBox Grid.Row="2" Grid.Column="2" Margin="8,3,0,3" VerticalContentAlignment="Center" ToolTip="เป็นเปอร์เซ็นต์ ใส่ทศนิยมได้" Text="{Binding Value, ElementName=DamageTextureScaleSlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnExceptions=True}" />
                      <TextBlock Grid.Row="3" Text="ความทึบของภาพ" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
                      <Slider Name="DamageTextureOpacitySlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="100" SmallChange="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                      <TextBox Grid.Row="3" Grid.Column="2" Margin="8,3,0,3" VerticalContentAlignment="Center" ToolTip="เป็นเปอร์เซ็นต์ ใส่ทศนิยมได้" Text="{Binding Value, ElementName=DamageTextureOpacitySlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnExceptions=True}" />
                    </Grid>
                    <TextBlock Style="{StaticResource HelpTextStyle}" Text="ปรับขนาดตัวเลขความเสียหาย และป๊อปอัป Critical, Weak Point และ Guard ส่วนอื่นของ UI ไม่เปลี่ยนแปลง ความทึบ 0% จะซ่อนป๊อปอัป ส่วน 100% จะแสดงตามที่เกมวาดไว้" />
                    <Button Content="รีเซ็ตป๊อปอัปความเสียหาย" HorizontalAlignment="Left" Margin="0,10,0,20" Click="ResetDamageUi_OnClick" />
                    <CheckBox Name="HideUiCheckBox" Content="ซ่อน UI เมื่อเกมเริ่มทำงาน" Margin="0,4" />
                    <CheckBox Name="HideCabinetHudCheckBox" Content="ซ่อน HUD ของตู้เกม: GP, CREDIT, ปุ่มปรับระดับเสียง และไอคอนสถานะ (ปุ่ม End Game ยังอยู่)" ToolTip="ปุ่ม GP และปุ่มปรับระดับเสียงที่ถูกซ่อนจะไม่ตอบสนองต่อการสัมผัสด้วย เสียงที่ออกจริงไม่เปลี่ยนแปลง จะมีผลเมื่อเริ่มเกมครั้งถัดไป" Margin="0,4" />
                    <WrapPanel Margin="0,8,0,12">
                      <TextBlock Text="ปุ่มลัดแสดง / ซ่อน UI" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSoftBrush}" />
                      <Button Name="HideUiKeyButton" Content="F10" MinWidth="150" Click="HideUiKeyButton_OnClick" PreviewKeyDown="HideUiKeyButton_OnPreviewKeyDown" LostKeyboardFocus="HideUiKeyButton_OnLostKeyboardFocus" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource HelpTextStyle}" Text="คลิกที่ปุ่ม แล้วกดปุ่มที่คุณต้องการ กด Esc เพื่อยกเลิก ปุ่มลัดจะทำงานขณะที่หน้าต่างเกมโฟกัสอยู่ กดอีกครั้งเพื่อให้ UI กลับมา" />
                    <Separator Margin="0,24,0,12" />
                    <TextBlock Style="{StaticResource HelpTextStyle}" Text="การตั้งค่าเหล่านี้จะมีผลเมื่อเริ่มเกมครั้งถัดไป สัดส่วนภาพที่กว้างขึ้นจะเห็นฉากได้มากขึ้น ส่วน UI จะอยู่กึ่งกลางตามสัดส่วนของตัวเอง" />
                    <Button Content="บันทึกการตั้งค่าการแสดงผล" HorizontalAlignment="Left" Padding="24,6" Margin="0,16,0,8" Click="SaveGraphicsButton_OnClick" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="การควบคุม">
                <local:ControlSettingsView x:Name="ControlsPanel" SaveRequested="ControlsPanel_OnSaveRequested" />
              </TabItem>
              <TabItem Header="เสียง">
                <local:AudioSettingsView />
              </TabItem>
            </TabControl>
          </TabItem>
          <TabItem Header="ขั้นสูง" Style="{StaticResource SidebarTabItemStyle}">
            <TabControl>
              <TabItem Header="เซิร์ฟเวอร์">
                <local:ServerSettingsView x:Name="ServerSettingsPanel" ConfigureRequested="ServerSettings_OnConfigure" />
              </TabItem>
              <TabItem Header="การวินิจฉัยและความช่วยเหลือ">
                <local:DiagnosticsView />
              </TabItem>
              <TabItem Header="ตัวชี้เมาส์">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <local:CursorSettingsView Margin="28" />
                </ScrollViewer>
              </TabItem>
              <TabItem Header="ดีบัก">
                <local:DebugSettingsView />
              </TabItem>
              <TabItem Header="โหมดถ่ายภาพ">
                <ContentControl Name="PhotoTabContent" Loaded="PhotoSettings_OnClick" />
              </TabItem>
              <TabItem Header="เกี่ยวกับ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="FGOAC scooby" FontWeight="SemiBold" FontSize="22" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" />
                    <TextBlock Name="AboutVersionText" Style="{StaticResource HelpTextStyle}" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                      <Button Content="ตรวจหาอัปเดต" Margin="0,0,10,0" Click="CheckUpdatesButton_OnClick" />
                      <TextBlock Name="AboutUpdateStatusText" Style="{StaticResource HelpTextStyle}" VerticalAlignment="Center" MaxWidth="470" />
                    </StackPanel>
                    <TextBlock Margin="0,0,0,8">
                      <Hyperlink Foreground="{StaticResource IceBrush}" NavigateUri="https://github.com/felisiach/fgoac-scooby-thaitranslation" RequestNavigate="AboutLink_OnRequestNavigate">เปิดใน GitHub</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,22">
                      <Hyperlink Foreground="{StaticResource IceBrush}" NavigateUri="https://github.com/felisiach/fgoac-scooby-thaitranslation/releases" RequestNavigate="AboutLink_OnRequestNavigate">ดูบันทึกการเปลี่ยนแปลง</Hyperlink>
                    </TextBlock>
                    <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,24" Text="FGOAC scooby เป็นโปรเจกต์ของแฟนเกมที่ให้ใช้งานฟรี ส่วน FGO Arcade เป็นของ Sega และ TYPE-MOON" />
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,20" />
                    <TextBlock Text="อีสเตอร์เอ้ก" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                    <local:EasterEggSettingsView Margin="0,0,0,26" />
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,16" />
                    <TextBlock Style="{StaticResource HelpTextStyle}" Foreground="{StaticResource TextFaintBrush}" Text="ขอบคุณ Cloud23333 ผู้สร้างแพลตฟอร์ม FGO Arcade แบบโลคัล ที่ทำให้สิ่งนี้เกิดขึ้นได้" />
                    <TextBlock Style="{StaticResource HelpTextStyle}" Foreground="{StaticResource TextFaintBrush}" Margin="0,6,0,0"><Run Text="เลเยอร์ความเข้ากันได้สำหรับ AMD และ Intel โดย fluphus: " /><Hyperlink Foreground="{StaticResource IceBrush}" NavigateUri="https://github.com/fluphus/fgo-arcade-amd-shim" RequestNavigate="AboutLink_OnRequestNavigate">github.com/fluphus/fgo-arcade-amd-shim</Hyperlink></TextBlock>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </TabItem>
        </TabControl>
        <GridSplitter Name="LogPanelSplitter" Grid.Column="1" Style="{StaticResource PanelSplitterStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
        <Grid Name="LogPanel" Grid.Column="2" Margin="0,10,10,10">
          <Grid.RowDefinitions>
            <RowDefinition Name="ServerLogRow" Height="*" MinHeight="150" />
            <RowDefinition Height="7" />
            <RowDefinition Name="InjectionLogRow" Height="*" MinHeight="150" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{StaticResource PlateLowBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="เซิร์ฟเวอร์" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="12,0" />
              </Border>
              <TextBox Name="ServerLogTextBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Margin="0" Padding="9" FontFamily="{StaticResource DigitFont}" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </Grid>
          </Border>
          <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalPanelSplitterStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
          <Border Grid.Row="2" Background="{StaticResource PlateLowBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="เกม" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="12,0" />
              </Border>
              <TextBox Name="InjectionLogTextBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Margin="0" Padding="9" FontFamily="{StaticResource DigitFont}" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="3" Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="RuntimeStatusText" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextTrimming="CharacterEllipsis" />
          <Button Name="ToggleLogsButton" Grid.Column="1" Content="ซ่อนล็อก" MinHeight="0" Height="26" FontSize="13" Padding="10,0" Margin="12,0,0,0" Click="ToggleLogs_OnClick" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
