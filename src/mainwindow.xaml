  </FrameworkElement.Resources>
  <Border Background="{StaticResource GroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource GroundBrush}" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <Image Source="platform.ico" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Name="HeaderBrandText" Foreground="{StaticResource TextSoftBrush}" FontSize="14" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource CaptionButtonStyle}" ToolTip="ย่อหน้าต่าง" AutomationProperties.Name="ย่อหน้าต่าง" Click="MinimizeButton_OnClick">
              <Path Width="12" Height="12" Stretch="None" Data="M1,8 L11,8" StrokeThickness="1" SnapsToDevicePixels="True" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Style="{StaticResource CaptionButtonStyle}" ToolTip="ขยายใหญ่สุด / คืนขนาด" AutomationProperties.Name="ขยายใหญ่สุดหรือคืนขนาด" Click="MaximizeButton_OnClick">
              <Rectangle Width="10" Height="10" StrokeThickness="1" SnapsToDevicePixels="True" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="ปิด" AutomationProperties.Name="ปิด" Click="CloseButton_OnClick">
              <Path Width="12" Height="12" Stretch="None" Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5" StrokeThickness="1" StrokeStartLineCap="Square" StrokeEndLineCap="Square" SnapsToDevicePixels="True" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <TabControl Name="SectionTabs" Style="{StaticResource SidebarTabControlStyle}" TabStripPlacement="Left" SelectionChanged="SectionTabs_OnSelectionChanged">
          <TabItem Name="PlayTab" Header="เล่น" Style="{StaticResource SidebarTabItemStyle}">
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!-- The first column takes the page width up to 1020 px, so the layout does not change with the length of the status sentence. -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1000*" MaxWidth="1020" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="40,28,40,40">
                    <Grid Margin="0,0,0,24">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Play" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Style="{StaticResource HelpTextStyle}" Text="The game on this PC, with its own server." />
                      <Button Name="ToggleLogsButton" Grid.Column="2" Style="{StaticResource QuietButtonStyle}" Content="Logs" ToolTip="Show or hide the server and game logs" VerticalAlignment="Center" Margin="0" Click="ToggleLogs_OnClick" />
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Height="320" VerticalAlignment="Top" Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                        <Grid>
                          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Visibility, ElementName=HeroFallbackImage}">
                            <Image Source="platform.ico" Width="56" Height="56" Opacity="0.5" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="No cards in the deck" Margin="0,16,0,4" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Pick up to 30 on Cards." HorizontalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
                          </StackPanel>
                          <Image Name="HeroFallbackImage" Width="0" Height="0" />
                          <Image Name="HeroCardImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="2">
                        <Border Name="StatusPill" Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20,14,8,14">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Name="StatusDot" Width="8" Height="8" Margin="0,8,14,0" VerticalAlignment="Top" Fill="{StaticResource TextFaintBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Name="RuntimeStatusText" FontSize="15" LineHeight="23" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                            <Button Name="StatusNextButton" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Margin="12,0,0,0" Click="StatusNextButton_OnClick" />
                            <Button Name="StatusMenuButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Top" Margin="8,-6,0,-6" ToolTip="Server and logs" AutomationProperties.Name="Server and logs" Click="StatusMenuButton_OnClick">
                              <Path Data="{StaticResource IconDots}" Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                              <Button.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Name="PillStartServerItem" Header="Start the local server" Click="StartServerButton_OnClick" />
                                  <MenuItem Name="PillStopServerItem" Header="Stop the local server" Click="StopServerButton_OnClick" />
                                  <MenuItem Name="PillUpdateLaterItem" Header="Later (hide the update until the next start)" Click="UpdateLaterItem_OnClick" />
                                  <MenuItem Header="Show logs" Click="ToggleLogs_OnClick" />
                                  <MenuItem Header="Open the logs folder" Click="OpenLogsButton_OnClick" />
                                  <MenuItem Header="Save a report" ToolTip="A zip of the logs and settings, without your card or recovery key, to attach when asking for help" Click="SaveReportItem_OnClick" />
                                </ContextMenu>
                              </Button.ContextMenu>
                            </Button>
                          </Grid>
                        </Border>
                        <ProgressBar Name="StatusProgress" Style="{StaticResource ThinProgressStyle}" Margin="12,6,12,0" Visibility="Hidden" />
                        <Grid Margin="0,14,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Button Name="StartGameButton" Style="{StaticResource PrimaryButtonStyle}" Content="เล่น" Height="56" FontSize="18" HorizontalAlignment="Stretch" Click="StartGameButton_OnClick" />
                          <Button Name="StopGameButton" Grid.Column="1" Style="{StaticResource StopGameButtonStyle}" Content="หยุดเกม" IsEnabled="False" Height="56" MinWidth="128" Margin="12,0,0,0" Click="StopGameButton_OnClick" />
                        </Grid>
                        <Border Margin="0,24,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1">
                          <DockPanel Height="52">
                            <TextBlock Text="มาสเตอร์" Style="{StaticResource RowLabelStyle}" />
                            <Button Name="ManageAccountsButton" DockPanel.Dock="Right" Style="{StaticResource QuietButtonStyle}" Content="Manage" Margin="0" ToolTip="Open the accounts page: reset, repair, grant items, summon results" Click="ManageAccountsButton_OnClick" />
                            <Button Name="MasterLineButton" Style="{StaticResource QuietButtonStyle}" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left" Margin="-10,0,0,0" ToolTip="Switch or add an account" Click="MasterLineButton_OnClick">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Name="MasterLineText" Text="กำลังโหลด..." FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Path Data="{StaticResource IconCaretDown}" Width="11" Height="11" Margin="10,1,0,0" Stretch="Uniform" Fill="{StaticResource TextSoftBrush}" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                          </DockPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                          <DockPanel Height="52">
                            <TextBlock Text="เด็ค" Style="{StaticResource RowLabelStyle}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButtonStyle}" Content="Edit on Cards" Margin="0" Click="EditDeckButton_OnClick" />
                            <TextBlock FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Text="{Binding Text, ElementName=DeckStatusText}" />
                          </DockPanel>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </Grid>
          </TabItem>
          <TabItem Name="OnlineTab" Header="Online" Style="{StaticResource SidebarTabItemStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1000*" MaxWidth="1020" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="40,28,40,40">
                  <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Online" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Margin="12,0,0,0" Padding="8,1" CornerRadius="6" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource WarnBrush}">
                      <TextBlock Text="Beta" FontSize="14" Foreground="{StaticResource WarnBrush}" />
                    </Border>
                    <TextBlock Grid.Column="2" Margin="16,0" VerticalAlignment="Center" Style="{StaticResource HelpTextStyle}" Text="Battles against other players on the community server." />
                    <Button Grid.Column="3" Style="{StaticResource QuietButtonStyle}" Content="Logs" ToolTip="Show or hide the server and game logs" VerticalAlignment="Center" Margin="0" Click="ToggleLogs_OnClick" />
                  </Grid>
                  <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20,14,8,14">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
