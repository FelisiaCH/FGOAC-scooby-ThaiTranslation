                              <Button Name="RemoveAllCopiesButton" VerticalAlignment="Top" Margin="4" MinHeight="0" Padding="4,2" Opacity="0" Tag="{Binding}" AutomationProperties.Name="Remove all copies" Click="DeckRemoveAllCopies_OnClick">
