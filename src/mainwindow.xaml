<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FGOLocalPlatform.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:kancolle="clr-namespace:DeckReaderUI.Kancolle" xmlns:local="clr-namespace:FGOLocalPlatform" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="" Icon="platform.ico" Width="1280" Height="800" MinWidth="1060" MinHeight="680" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource GroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" Closing="MainWindow_OnClosing" KeyDown="MainWindow_OnKeyDown" Activated="Window_OnActivated" Deactivated="Window_OnDeactivated">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="CardFormMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}" />
      <Style x:Key="StopGameButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DangerButtonStyle}">
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="OwnedOnlyToggleStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource SwitchToggleStyle}">
        <Setter Property="Content" Value="เฉพาะการ์ดที่มีอยู่" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="11,4" />
      </Style>
      <Style x:Key="EnglishTextToggleStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource SwitchToggleStyle}">
        <Setter Property="Content" Value="Game text: Japanese" />
        <Style.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Content" Value="Game text: English" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource GroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="CaptionSurface" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="CaptionSurface" Property="Border.Background" Value="{StaticResource PlateHighBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="CaptionSurface" Property="Border.Background" Value="{StaticResource PlateBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Close is the one caption button that turns red under the pointer, as Windows draws it. -->
      <Style x:Key="CloseCaptionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="CaptionSurface" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="CaptionSurface" Property="Border.Background" Value="{StaticResource CloseHoverBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PanelSplitterStyle" TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="{StaticResource GroundBrush}" />
        <Setter Property="GridSplitter.ShowsPreview" Value="True" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GridSplitter}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Border Name="Grip" Background="{StaticResource LineBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1" Height="30" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Grip" Property="Border.Background" Value="{StaticResource IceBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="HorizontalPanelSplitterStyle" TargetType="{x:Type GridSplitter}" BasedOn="{StaticResource PanelSplitterStyle}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GridSplitter}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Border Name="Grip" Background="{StaticResource LineBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="1" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Grip" Property="Border.Background" Value="{StaticResource IceBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="CardIconRowTemplate">
        <ItemsControl HorizontalAlignment="Left" ItemsSource="{Binding Cards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:Key="{DataTemplateKey {x:Type local:CardStack}}" DataType="{x:Type local:CardStack}">
              <Button Width="144" Height="200" Margin="0" Padding="0" Background="{x:Null}" BorderBrush="{x:Null}" HorizontalContentAlignment="Stretch" Tag="{Binding}" Click="IconCardButton_OnClick" MouseDoubleClick="IconCardButton_OnMouseDoubleClick">
                <Grid Margin="2" Width="140" Height="196">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="126" />
                    <RowDefinition Height="70" />
                  </Grid.RowDefinitions>
                  <Border Background="{StaticResource PlateLowBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="3">
                    <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Thumbnail, IsAsync=True}" />
                  </Border>
                  <Border Grid.Row="1" Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,1,1" Padding="6,3">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Text="{Binding EnglishName}" />
                      <TextBlock TextAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryNameStyle}" FontSize="14" Text="{Binding JapaneseName}" />
                      <TextBlock TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextFaintBrush}" FontSize="14" Text="{Binding EntityLabel}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>
      <!-- Text and icon only; a surface appears under the pointer. -->
      <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <!-- A sidebar footer link: a 36 px row with the mark and its name, aligned with the page rows. -->
      <Style x:Key="SidebarLinkStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButtonStyle}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SettingsCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,16" />
      </Style>
      <Style x:Key="SettingsCardTitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SectionTitleStyle}">
        <Setter Property="Margin" Value="28,24,28,0" />
      </Style>
      <Style x:Key="RowLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Width" Value="88" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
