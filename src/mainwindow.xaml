                                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButtonStyle}" Width="28" Height="26" MinHeight="0" Padding="0" Margin="0" Content="+" Tag="{Binding}" ToolTip="One copy more" AutomationProperties.Name="One copy more" Click="DeckCopyAdd_OnClick" />
                                    <TextBlock TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource IceBrush}" FontSize="14" Text="{Binding Count, StringFormat=×{0}}" />
