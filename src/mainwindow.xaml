                          <WrapPanel Margin="0,8,0,12">
                            <TextBlock Text="ปุ่มลัดแสดง / ซ่อน UI" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSoftBrush}" />
                            <Button Name="HideUiKeyButton" Content="F10" MinWidth="150" Click="HideUiKeyButton_OnClick" PreviewKeyDown="HideUiKeyButton_OnPreviewKeyDown" LostKeyboardFocus="HideUiKeyButton_OnLostKeyboardFocus" />
                          </WrapPanel>
                          <TextBlock Style="{StaticResource HelpTextStyle}" Text="คลิกที่ปุ่ม แล้วกดปุ่มที่คุณต้องการ กด Esc เพื่อยกเลิก ปุ่มลัดจะทำงานขณะที่หน้าต่างเกมโฟกัสอยู่ กดอีกครั้งเพื่อให้ UI กลับมา" />
                          <Separator Margin="0,24,0,12" />
                          <TextBlock Style="{StaticResource HelpTextStyle}" Text="การตั้งค่าเหล่านี้จะมีผลเมื่อเริ่มเกมครั้งถัดไป สัดส่วนภาพที่กว้างขึ้นจะเห็นฉากได้มากขึ้น ส่วน UI จะอยู่กึ่งกลางตามสัดส่วนของตัวเอง" />
                          <Button Content="บันทึกการตั้งค่าการแสดงผล" HorizontalAlignment="Left" Padding="24,6" Margin="0,16,0,8" Click="SaveGraphicsButton_OnClick" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}" Tag="Audio">
                      <StackPanel>
                        <TextBlock Text="Audio" Style="{StaticResource SettingsCardTitleStyle}" />
                        <local:AudioSettingsView x:Name="AudioPanel" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}" Tag="PC play">
                      <StackPanel>
                        <TextBlock Text="PC play" Style="{StaticResource SettingsCardTitleStyle}" />
                        <local:PcPlaySettingsView x:Name="PcPlayPanel" SaveRequested="PcPlayPanel_OnSaveRequested" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}" Tag="Battle effects">
                      <StackPanel>
                        <TextBlock Text="Battle effects" Style="{StaticResource SettingsCardTitleStyle}" />
                        <local:BattleEffectsView x:Name="BattleEffectsPanel" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}" Tag="Local server">
                      <StackPanel>
                        <TextBlock Text="Local server" Style="{StaticResource SettingsCardTitleStyle}" />
                        <local:ServerSettingsView x:Name="ServerSettingsPanel" ConfigureRequested="ServerSettings_OnConfigure" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}" Tag="Diagnostics and Help">
                      <StackPanel>
                        <TextBlock Text="Diagnostics and Help" Style="{StaticResource SettingsCardTitleStyle}" />
                        <local:DiagnosticsView />
                      </StackPanel>
                    </Border>
                    <TextBlock Name="SettingsFilterEmptyText" Visibility="Collapsed" Style="{StaticResource HelpTextStyle}" Text="No section matches the filter. Clear the box to show every section." />
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </Grid>
          </TabItem>
          <TabItem Name="AboutTab" Header="เกี่ยวกับ" Style="{StaticResource SidebarTabItemStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="40,28,40,40" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="About" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,24" />
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="FGOAC scooby" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Name="AboutVersionText" Style="{StaticResource HelpTextStyle}" Margin="0,6,0,20" />
                    <DockPanel>
                      <Button Content="ตรวจหาอัปเดต" Margin="0,0,16,0" VerticalAlignment="Center" Click="CheckUpdatesButton_OnClick" />
                      <TextBlock Name="AboutUpdateStatusText" Style="{StaticResource HelpTextStyle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Margin="0,20,0,0">
                      <Hyperlink Foreground="{StaticResource IceBrush}" NavigateUri="https://github.com/githubuser420x/FGOAC-scooby/releases" RequestNavigate="AboutLink_OnRequestNavigate">What's new in each version</Hyperlink>
                    </TextBlock>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Community" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" Text="The source, the releases and the bug reports live on GitHub; help and news are on Discord." />
                    <WrapPanel>
                      <Button Tag="https://github.com/githubuser420x/FGOAC-scooby" Margin="0,0,8,0" Click="SidebarLink_OnClick">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource IconGitHub}" Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" Fill="{StaticResource TextBrush}" />
                          <TextBlock Text="GitHub" />
                        </StackPanel>
                      </Button>
                      <Button Tag="https://discord.gg/RNT6KzEgk" Margin="0,0,8,0" Click="SidebarLink_OnClick">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource IconDiscord}" Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" Fill="{StaticResource TextBrush}" />
                          <TextBlock Text="Discord" />
                        </StackPanel>
                      </Button>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border x:Name="EasterEggCard" Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                  <StackPanel>
                    <TextBlock Text="อีสเตอร์เอ้ก" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                    <local:EasterEggSettingsView />
                  </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,8" Text="FGOAC scooby เป็นโปรเจกต์ของแฟนเกมที่ให้ใช้งานฟรี ส่วน FGO Arcade เป็นของ Sega และ TYPE-MOON" />
                <TextBlock Style="{StaticResource HelpTextStyle}" Foreground="{StaticResource TextFaintBrush}" Text="ขอบคุณ Cloud23333 ผู้สร้างแพลตฟอร์ม FGO Arcade แบบโลคัล ที่ทำให้สิ่งนี้เกิดขึ้นได้" />
                <TextBlock Style="{StaticResource HelpTextStyle}" Foreground="{StaticResource TextFaintBrush}" Margin="0,6,0,0"><Run Text="เลเยอร์ความเข้ากันได้สำหรับ AMD และ Intel โดย fluphus: " /><Hyperlink Foreground="{StaticResource IceBrush}" NavigateUri="https://github.com/fluphus/fgo-arcade-amd-shim" RequestNavigate="AboutLink_OnRequestNavigate">github.com/fluphus/fgo-arcade-amd-shim</Hyperlink></TextBlock>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        <!-- The Logs drawer, over the right of the Play and Online pages; the sidebar keeps its 188 px. -->
        <Grid Name="LogsDrawer" Margin="188,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Name="WorkspaceColumn" Width="*" />
            <ColumnDefinition Name="LogSplitterColumn" Width="0" />
            <ColumnDefinition Name="LogPanelColumn" Width="0" />
          </Grid.ColumnDefinitions>
          <GridSplitter Name="LogPanelSplitter" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource PanelSplitterStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
          <Grid Name="LogPanel" Grid.Column="2" Visibility="Collapsed" Background="{StaticResource PlateBrush}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="150" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" IsHitTestVisible="False" />
            <StackPanel Margin="20,16,12,12">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Margin="0" ToolTip="Close the logs (Esc)" AutomationProperties.Name="Close the logs" Click="ToggleLogs_OnClick">
                  <Path Data="{StaticResource IconX}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource QuietButtonStyle}" Content="Open folder" Margin="0,0,4,0" Click="OpenLogsButton_OnClick" />
                <TextBlock Text="Logs" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Margin="0,8,8,0" Name="LogsStatusText" Style="{StaticResource HelpTextStyle}" Foreground="{StaticResource TextBrush}" Text="{Binding Text, ElementName=RuntimeStatusText}" />
            </StackPanel>
            <Border Grid.Row="1" Margin="12,0,12,12" Background="{StaticResource PlateLowBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8">
                  <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Name="LauncherLogSourceButton" GroupName="LogSource" Style="{StaticResource SegmentStyle}" Content="Launcher" ToolTip="The launcher's own lines from today" Click="LogSource_OnClick" />
                      <RadioButton Name="GameLogSourceButton" GroupName="LogSource" Style="{StaticResource SegmentStyle}" Content="Game" IsChecked="True" ToolTip="The launch script's output, and the launcher's account and update lines" Click="LogSource_OnClick" />
                      <RadioButton Name="ServerLogSourceButton" GroupName="LogSource" Style="{StaticResource SegmentStyle}" Content="Server" ToolTip="The last lines of the local server's log" Click="LogSource_OnClick" />
                    </StackPanel>
                  </Border>
                </Border>
                <TextBox Name="LauncherLogTextBox" Grid.Row="1" Visibility="Collapsed" IsReadOnly="True" Background="Transparent" BorderThickness="0" Margin="0" Padding="9" FontFamily="{StaticResource DigitFont}" FontSize="14" VerticalContentAlignment="Top" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                <TextBox Name="InjectionLogTextBox" Grid.Row="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" Margin="0" Padding="9" FontFamily="{StaticResource DigitFont}" FontSize="14" VerticalContentAlignment="Top" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                <TextBox Name="ServerLogTextBox" Grid.Row="1" Visibility="Collapsed" IsReadOnly="True" Background="Transparent" BorderThickness="0" Margin="0" Padding="9" FontFamily="{StaticResource DigitFont}" FontSize="14" VerticalContentAlignment="Top" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
        <StackPanel Width="188" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,14">
          <Button Style="{StaticResource SidebarLinkStyle}" Tag="https://github.com/githubuser420x/FGOAC-scooby" ToolTip="github.com/githubuser420x/FGOAC-scooby" Click="SidebarLink_OnClick">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IconGitHub}" Width="18" Height="18" Margin="0,0,12,0" Stretch="Uniform" Fill="{StaticResource TextBrush}" />
              <TextBlock Text="GitHub" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SidebarLinkStyle}" Tag="https://discord.gg/RNT6KzEgk" ToolTip="discord.gg/RNT6KzEgk" Click="SidebarLink_OnClick">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IconDiscord}" Width="18" Height="18" Margin="0,0,12,0" Stretch="Uniform" Fill="{StaticResource TextBrush}" />
              <TextBlock Text="Discord" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Name="SidebarVersionText" Margin="22,10,22,0" FontFamily="{StaticResource DigitFont}" FontSize="14" Foreground="{StaticResource TextFaintBrush}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
