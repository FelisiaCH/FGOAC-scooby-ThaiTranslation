<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FGOLocalPlatform.NamePromptDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Save as" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource GroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
  <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20" Margin="10">
    <StackPanel>
      <TextBlock Name="LabelText" FontSize="13" Foreground="{StaticResource TextSoftBrush}" />
      <TextBox Name="NameTextBox" MaxLength="40" Margin="0,6,0,14" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Width="96" IsDefault="True" Click="SaveButton_OnClick" />
        <Button Content="Cancel" Width="96" IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
