<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FGOLocalPlatform.NewAccountDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="บัญชีในเครื่องใหม่" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource GroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20" Margin="10">
    <StackPanel>
      <TextBlock Text="ชื่อมาสเตอร์ (แสดงในเกม)" FontSize="13" Foreground="{StaticResource TextSoftBrush}" />
      <TextBox Name="MasterNameTextBox" MaxLength="32" Margin="0,6,0,14" />
      <TextBlock Text="โหมดบัญชี" FontSize="13" Foreground="{StaticResource TextSoftBrush}" />
      <ComboBox Name="AccountModeComboBox" Margin="0,6,0,6" SelectedIndex="0">
        <ComboBoxItem Content="normal - บัญชีมาตรฐาน (มีทรัพยากรเริ่มต้น)" Tag="normal" />
      </ComboBox>
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" Text="บัญชีใหม่จะเริ่มจากสถานะตั้งต้นมาตรฐาน เมื่อสร้างบัญชีแล้ว ให้ใช้ตัวเลือกพิมพ์การ์ดและเพิ่มค่าสถานะในหน้าบัญชีได้ทุกเมื่อที่ต้องการ" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="สร้าง" Style="{StaticResource AccentButtonStyle}" Width="96" IsDefault="True" Click="CreateButton_OnClick" />
        <Button Content="ยกเลิก" Width="96" IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>