<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.ServerSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform" Loaded="View_OnLoaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" Text="auto จะเชื่อมต่อไปยังเซิร์ฟเวอร์บนพีซีเครื่องนี้ผ่านเครือข่ายเสมือนในตัว และใช้งานได้โดยไม่ต้องต่ออินเทอร์เน็ต หากต้องการใช้เซิร์ฟเวอร์ระยะไกล ให้กรอกที่อยู่ IPv4 อื่นแทน" />
      <Grid>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="TextBox.TextAlignment" Value="Center" />
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="44" />
          <RowDefinition Height="44" />
          <RowDefinition Height="44" />
          <RowDefinition Height="44" />
          <RowDefinition Height="44" />
        </Grid.RowDefinitions>
        <TextBlock Text="ที่อยู่เซิร์ฟเวอร์ (auto = ออฟไลน์)" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="HostBox" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
        <TextBlock Text="พอร์ตเกม / ALL.Net" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="HttpBox" Grid.Row="1" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
        <TextBlock Text="พอร์ต HTTPS ของ Billing" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="BillingBox" Grid.Row="2" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
        <TextBlock Text="พอร์ตเครื่องอ่านการ์ด Aime" Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="AimeBox" Grid.Row="3" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
        <TextBlock Text="พอร์ตฐานข้อมูลในเครื่อง" Grid.Row="4" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="DatabaseBox" Grid.Row="4" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
      </Grid>
      <WrapPanel Margin="0,16,0,16">
        <Button Content="บันทึกการตั้งค่า" Width="160" Padding="12,6" Margin="0,0,8,0" Click="Configure_OnClick" />
        <Button Content="คืนค่าเริ่มต้น" Width="160" Padding="12,6" Margin="0,0,8,0" Click="Defaults_OnClick" />
        <Button Content="รีเฟรชสถานะ" Width="160" Padding="12,6" Click="Refresh_OnClick" />
      </WrapPanel>
      <TextBlock Text="พอร์ตต้องเป็นจำนวนเต็มตั้งแต่ 1 ถึง 65535 และห้ามมีสองบริการใช้พอร์ตเดียวกัน การบันทึกจะหยุดเซิร์ฟเวอร์ในเครื่อง จึงควรออกจากเกมก่อน ทั้งการบันทึกและการเปิดหน้านี้ไม่ได้เริ่มเซิร์ฟเวอร์ ปุ่ม คืนค่าเริ่มต้น เพียงเติมค่าลงในช่องเท่านั้น - ให้คลิก บันทึกการตั้งค่า เพื่อนำไปใช้จริง" Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" />
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource PlateBrush}" Padding="14">
        <TextBlock Name="InfoText" Text="กำลังอ่านการตั้งค่า..." TextWrapping="Wrap" LineHeight="20" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>