<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.SummonSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource GroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <Grid Margin="28,20,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="เซอร์แวนต์และ Craft Essence ใช้อัตราการสุ่มชุดเดียวกัน" Style="{StaticResource SectionTitleStyle}" />
      <TextBlock Margin="0,8,0,12" Style="{StaticResource HelpTextStyle}" Text="การ์ดปกติและการ์ดเสริมใช้ตารางสุ่มในเครื่องร่วมกันหนึ่งตาราง ส่วนการ์ดที่ตายตัวตามเนื้อเรื่องจะถูกกันออกไป โอกาสสุ่มได้คือน้ำหนักหารด้วยน้ำหนักรวม และค่า 0 หมายความว่าการ์ดนั้นจะไม่ถูกสุ่มเลย ไม่มีการเพิ่มอัตราแบบซ่อนไว้ และไม่มีการการันตีเมื่อสุ่มครบสิบครั้ง" />
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <TextBlock Text="ค้นหาชื่อ / หมายเลข" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSoftBrush}" />
      <ComboBox Name="CategoryFilter" DockPanel.Dock="Right" Width="265" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="Filter_OnChanged">
        <ComboBoxItem Content="ปกติ + เสริม (สุ่มได้)" />
        <ComboBoxItem Content="การซัมมอนปกติ" />
        <ComboBoxItem Content="เสริม" />
        <ComboBoxItem Content="เนื้อเรื่อง (ตายตัว อ่านอย่างเดียว)" />
      </ComboBox>
      <ComboBox Name="KindFilter" DockPanel.Dock="Right" Width="125" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="Filter_OnChanged">
        <ComboBoxItem Content="ทุกชนิด" />
        <ComboBoxItem Content="เซอร์แวนต์" />
        <ComboBoxItem Content="Craft Essence" />
      </ComboBox>
      <TextBox Name="SearchBox" ToolTip="ค้นหาจากชื่อภาษาญี่ปุ่น ชื่อภาษาอังกฤษ หมายเลขไฟล์ ชื่อไฟล์เต็ม หรือ ID การ์ด" TextChanged="Search_OnChanged" />
    </DockPanel>
    <WrapPanel Name="EditButtons" Grid.Row="2">
      <Button Content="เท่ากันทั้งหมด" Click="EqualAll_OnClick" />
      <Button Content="เฉพาะที่เลือก (100%)" Click="OnlyOne_OnClick" />
      <Button Content="เท่ากันเฉพาะที่เลือก" Click="EqualSelected_OnClick" />
      <Button Content="ยกเว้นที่เลือก" Click="Exclude_OnClick" />
      <TextBlock Text="กด Ctrl / Shift เพื่อเลือกมากกว่าหนึ่งรายการ" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" Margin="8,0,0,6" />
    </WrapPanel>
    <DataGrid Name="CardsGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow" MinRowHeight="112" HeadersVisibility="Column" GridLinesVisibility="Horizontal" EnableRowVirtualization="True" CellEditEnding="Grid_OnCellEditEnding" BeginningEdit="Grid_OnBeginningEdit" SelectionChanged="Grid_OnSelectionChanged">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
          </Style>
          <Style x:Key="WrappedCell" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,4" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="การ์ด" Width="84" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Image Height="90" Width="68" Margin="3" Stretch="Uniform" Source="{Binding Icon}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="ชื่อ / ID ภายใน" Width="*" MinWidth="190" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel VerticalAlignment="Center">
                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding EnglishName}" ToolTip="{Binding AcquisitionNote}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryNameStyle}" Margin="6,4" Text="{Binding JapaneseName}" />
                <TextBlock Foreground="{StaticResource TextSoftBrush}" Margin="6,5,6,0" Text="{Binding FileNumber}" ToolTip="{Binding FileName}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="หมวดหมู่" Width="100" MaxWidth="140" ElementStyle="{StaticResource WrappedCell}" IsReadOnly="True" Binding="{Binding CategoryName}" />
        <DataGridTextColumn Header="ชนิด / การ์ด" Width="112" ElementStyle="{StaticResource WrappedCell}" IsReadOnly="True" Binding="{Binding KindName}" />
        <DataGridTextColumn Header="ความหายาก" Width="65" ElementStyle="{StaticResource WrappedCell}" IsReadOnly="True" Binding="{Binding Stars}" />
        <DataGridTextColumn Header="ID การ์ด" Width="85" ElementStyle="{StaticResource WrappedCell}" IsReadOnly="True" Binding="{Binding TcId}" />
        <DataGridTextColumn Header="น้ำหนัก (จำนวนเต็ม)" Width="158" ElementStyle="{StaticResource WrappedCell}" Binding="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}" />
        <DataGridTextColumn Header="โอกาสสุ่มได้" Width="120" ElementStyle="{StaticResource WrappedCell}" IsReadOnly="True" Binding="{Binding Probability}" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="4" Margin="0,12,0,8">
      <TextBlock Name="SummaryText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
      <TextBlock Name="StatusText" Margin="0,6,0,0" Style="{StaticResource HelpTextStyle}" />
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,6,0,0" Foreground="{StaticResource TextFaintBrush}" Text="หมวดเสริมครอบคลุมการ์ดที่ได้จากรางวัลในเครื่อง ค่า Bond และอื่น ๆ ทำนองเดียวกัน แทนที่จะได้จากการซัมมอนปกติ และเก็บภาพการ์ดพื้นฐานไว้แบบเดียวต่อหนึ่งใบ ส่วนการ์ดเนื้อเรื่องและการ์ดจากการเคลียร์ครั้งแรกจะแสดงแยกไว้ต่างหากและอยู่นอกกลุ่มสุ่ม ตั๋วซัมมอนแบบ Normal และ Fatal จะสุ่มเฉพาะจากภาพการ์ดที่ตั๋วนั้นรองรับ โดยใช้น้ำหนักชุดเดียวกันนี้ ส่วนการแลกเปลี่ยนแบบตายตัวจะไม่ได้รับผลกระทบ" />
    </StackPanel>
    <DockPanel Grid.Row="5" Margin="0,8,0,4">
      <TextBlock DockPanel.Dock="Left" Text="พรีเซ็ต" Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Name="PresetComboBox" DockPanel.Dock="Left" Width="220" VerticalAlignment="Center" ToolTip="ตารางอัตราที่คุณบันทึกไว้ ปุ่ม โหลด จะเติมตารางด้วยรายการที่เลือก แล้วคลิก บันทึก เพื่อให้เซิร์ฟเวอร์นำไปใช้" />
      <Button DockPanel.Dock="Left" Content="บันทึกเป็น" Height="40" Margin="6,3,3,3" ToolTip="บันทึกตารางนี้ภายใต้ชื่อที่กำหนด" Click="PresetSave_OnClick" />
      <Button DockPanel.Dock="Left" Content="โหลด" Height="40" Margin="3" Click="PresetLoad_OnClick" />
      <Button DockPanel.Dock="Left" Content="ลบ" Height="40" Margin="3" Click="PresetDelete_OnClick" />
      <Button DockPanel.Dock="Left" Content="ส่งออก" Height="40" Margin="12,3,3,3" ToolTip="บันทึกสำเนาของพรีเซ็ตที่เลือกไว้ในที่ที่คุณแชร์ต่อได้ ค่าเริ่มต้นคือเดสก์ท็อป" Click="PresetExport_OnClick" />
      <Button DockPanel.Dock="Left" Content="นำเข้า" Height="40" Margin="3" ToolTip="เพิ่มไฟล์พรีเซ็ตที่มีคนส่งให้คุณเข้าไปในรายการ แล้วโหลดขึ้นมาใช้" Click="PresetImport_OnClick" />
      <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"><Hyperlink Foreground="{StaticResource IceBrush}" Click="PresetFolderLink_OnClick">เปิดโฟลเดอร์</Hyperlink></TextBlock>
    </DockPanel>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="โหลดใหม่" Height="40" Margin="3" VerticalAlignment="Center" Click="Reload_OnClick" />
      <Button Name="SaveButton" Content="บันทึก · มีผลกับการสุ่มครั้งถัดไป" Height="40" Margin="3" VerticalAlignment="Center" Click="Save_OnClick" />
    </StackPanel>
  </Grid>
</UserControl>