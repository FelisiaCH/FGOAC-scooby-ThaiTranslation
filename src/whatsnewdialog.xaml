<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FGOLocalPlatform.WhatsNewDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FGOAC scooby" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource GroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
  <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20" Margin="10">
    <StackPanel>
      <TextBlock Name="HeadingText" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
      <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
        <TextBlock Name="BodyText" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextBrush}" />
      </ScrollViewer>
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,12,0,14" Text="ประวัติทั้งหมดอยู่ที่ เกี่ยวกับ > ดูบันทึกการเปลี่ยนแปลง" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="ตกลง" Style="{StaticResource AccentButtonStyle}" Width="96" IsDefault="True" IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
